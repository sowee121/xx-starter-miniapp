{
  "poems": [
    {
      "id": "yong-e",
      "title": "咏鹅",
      "author": "唐 · 骆宾王",
      "cover": "poem-yong-e",
      "lines": [
        { "text": "鹅鹅鹅，" },
        { "text": "曲项向天歌。" },
        { "text": "白毛浮绿水，" },
        { "text": "红掌拨清波。" }
      ],
      "fullText": "鹅鹅鹅，曲项向天歌。白毛浮绿水，红掌拨清波。"
    },
    {
      "id": "jing-ye-si",
      "title": "静夜思",
      "author": "唐 · 李白",
      "cover": "poem-jing-ye-si",
      "lines": [
        { "text": "床前明月光，" },
        { "text": "疑是地上霜。" },
        { "text": "举头望明月，" },
        { "text": "低头思故乡。" }
      ],
      "fullText": "床前明月光，疑是地上霜。举头望明月，低头思故乡。"
    },
    {
      "id": "min-nong",
      "title": "悯农",
      "author": "唐 · 李绅",
      "cover": "poem-min-nong",
      "lines": [
        { "text": "锄禾日当午，" },
        { "text": "汗滴禾下土。" },
        { "text": "谁知盘中餐，" },
        { "text": "粒粒皆辛苦。" }
      ],
      "fullText": "锄禾日当午，汗滴禾下土。谁知盘中餐，粒粒皆辛苦。"
    },
    {
      "id": "chun-xiao",
      "title": "春晓",
      "author": "唐 · 孟浩然",
      "cover": "poem-chun-xiao",
      "lines": [
        { "text": "春眠不觉晓，" },
        { "text": "处处闻啼鸟。" },
        { "text": "夜来风雨声，" },
        { "text": "花落知多少。" }
      ],
      "fullText": "春眠不觉晓，处处闻啼鸟。夜来风雨声，花落知多少。"
    },
    {
      "id": "deng-guan-que-lou",
      "title": "登鹳雀楼",
      "author": "唐 · 王之涣",
      "cover": "poem-deng-guan-que-lou",
      "lines": [
        { "text": "白日依山尽，" },
        { "text": "黄河入海流。" },
        { "text": "欲穷千里目，" },
        { "text": "更上一层楼。" }
      ],
      "fullText": "白日依山尽，黄河入海流。欲穷千里目，更上一层楼。"
    },
    {
      "id": "wang-lu-shan-pu-bu",
      "title": "望庐山瀑布",
      "author": "唐 · 李白",
      "cover": "poem-wang-lu-shan-pu-bu",
      "lines": [
        { "text": "日照香炉生紫烟，" },
        { "text": "遥看瀑布挂前川。" },
        { "text": "飞流直下三千尺，" },
        { "text": "疑是银河落九天。" }
      ],
      "fullText": "日照香炉生紫烟，遥看瀑布挂前川。飞流直下三千尺，疑是银河落九天。"
    }
  ]
}
