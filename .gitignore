# macOS
.DS_Store
**/.DS_Store

# 微信开发者工具本地个人配置
project.private.config.json

# 云开发 / CloudBase CLI 本地状态
.cloudbase/

# 封面生成等本地草稿（勿入库；产物进 docs/design/atoms 与分包 static）
/assets/

# 原子覆盖前的本地历史（体积大，不入库；找回看目录时间戳）
docs/design/atoms/_history/

# 依赖
node_modules/
miniprogram_npm/

# 日志与临时文件
*.log
.tmp/
.tmp-test/
__pycache__/
*.pyc

# ---------- 密钥 / 凭据（切勿入库）----------
# miniprogram-ci 代码上传私钥目录（保留空目录占位）
secrets/**
!secrets/.gitkeep
# 预览二维码等 CI 产物
.ci-output/
# 常见密钥与证书文件名（任意路径）
*.key
*.pem
*.p12
*.pfx
*.p8
id_rsa
id_ed25519
# 环境变量与本地覆盖
.env
.env.*
!.env.example
*.local
# CloudBase / 腾讯云本地配置（若含密钥）
cloudbaserc.local.json
**/credentials.json
**/serviceAccount*.json

# 编辑器
.idea/
.vscode/
.codebuddy/
*.swp
*.swo
CODEBUDDY.md
