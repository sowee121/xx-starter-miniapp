.home-feature-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-card);
  height: 196rpx;
  padding: 0 var(--pad-card) 0 0;
  overflow: hidden;
  border-radius: var(--radius-card);
  corner-shape: var(--corner-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-feature-card.is-reward {
  height: 164rpx;
  padding: 0 var(--pad-card) 0 0;
}

.home-feature-card:active {
  transform: scale(0.985);
}

.home-feature-card__mascot {
  width: 172rpx;
  height: 172rpx;
  flex-shrink: 0;
}

.home-feature-card__mascot.is-sm {
  width: 140rpx;
  height: 140rpx;
}

.home-feature-card__title {
  font-size: var(--font-title);
}

.home-feature-card__sub {
  white-space: nowrap;
}

.home-feature-card__sockets {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-snug);
}

.home-feature-card__socket {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: rgba(154, 182, 138, 0.22);
  box-shadow:
    inset 0 5rpx 9rpx rgba(104, 136, 102, 0.26),
    inset 0 -4rpx 8rpx rgba(255, 255, 255, 0.75);
}

.home-feature-card__socket.is-on {
  background: rgba(255, 255, 255, 0.55);
  box-shadow:
    inset 0 4rpx 8rpx rgba(104, 136, 102, 0.16),
    inset 0 -4rpx 8rpx rgba(255, 255, 255, 0.8);
}

.home-feature-card__socket-star {
  width: 56rpx;
  height: 56rpx;
}

.home-feature-card__chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 176rpx;
  height: 88rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  font-size: var(--font-hint);
  font-weight: 700;
  letter-spacing: var(--letter-btn);
  color: #ffffff;
  background: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.home-feature-card__deco {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  pointer-events: none;
}
