.home-feature-card {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  height: 180rpx;
  padding: 0 30rpx;
  overflow: hidden;
  border-radius: 48rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-feature-card.is-reward {
  height: 150rpx;
}

.home-feature-card:active {
  transform: scale(0.985);
}

.home-feature-card__mascot {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
}

.home-feature-card__mascot.is-sm {
  width: 128rpx;
  height: 128rpx;
}

.home-feature-card__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.home-feature-card__title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #35553f;
}

.home-feature-card__sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.3;
  color: #6e8f76;
}

.home-feature-card__sockets {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 12rpx;
  gap: 8rpx;
}

.home-feature-card__socket {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: rgba(154, 182, 138, 0.22);
  box-shadow:
    inset 0 5rpx 9rpx rgba(104, 136, 102, 0.26),
    inset 0 -4rpx 8rpx rgba(255, 255, 255, 0.75);
}

.home-feature-card__socket.is-on {
  background: rgba(255, 255, 255, 0.55);
  box-shadow:
    inset 0 4rpx 8rpx rgba(104, 136, 102, 0.16),
    inset 0 -4rpx 8rpx rgba(255, 255, 255, 0.8);
}

.home-feature-card__socket-star {
  width: 34rpx;
  height: 34rpx;
}

.home-feature-card__chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 76rpx;
  flex-shrink: 0;
  border-radius: 38rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(180deg, #93c496 0%, #77b07c 100%);
  box-shadow: var(--shadow-chip);
}

.home-feature-card__deco {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  width: 56rpx;
  height: 56rpx;
  pointer-events: none;
}
