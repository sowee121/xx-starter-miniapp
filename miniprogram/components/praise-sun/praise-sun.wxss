.praise-sun {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: var(--letter-btn); /* 全站字距；弹层样式隔离需自写 */
  background: rgba(65, 87, 75, 0.22);
  opacity: 0;
  animation: praise-sun-in 250ms ease-out forwards;
}

.praise-sun__card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-block);
  width: var(--size-praise);
  min-height: var(--size-praise-min);
  padding: var(--pad-card-xl);
  border-radius: var(--radius-card);
  box-sizing: border-box;
  overflow: hidden;
  text-align: center;
  background: var(--tone-cream);
  box-shadow: var(--shadow-clay-praise);
  opacity: 0;
  transform: translateY(24rpx) scale(0.96);
  animation: praise-card-in 250ms ease-out forwards;
}

.praise-sun.is-closing {
  animation: praise-sun-out 250ms ease-in forwards;
}

.praise-sun.is-closing .praise-sun__card {
  animation: praise-card-out 250ms ease-in forwards;
}

.praise-sun__card.is-soft-fail {
  background: var(--tone-soft-fail);
}

.praise-sun__card.is-soft-fail .praise-sun__text {
  color: var(--note);
}

.praise-sun__card.is-exchange {
  background: var(--tone-rose);
}

.praise-sun__card.is-exchange .praise-sun__text {
  color: #7a4f63;
}

.praise-sun__icon-slot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size-praise-icon);
  height: var(--size-praise-icon);
  flex-shrink: 0;
}

.praise-sun__icon {
  display: block;
  width: var(--size-praise-icon);
  height: var(--size-praise-icon);
  vertical-align: middle;
}

.praise-sun__body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-soft);
}

.praise-sun__text {
  font-size: var(--font-display);
  color: var(--ink);
  font-weight: 700;
  line-height: 1.2;
}

.praise-sun__desc {
  color: var(--muted);
  font-size: var(--font-hint);
  line-height: 1.3;
}

.praise-sun__continue {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size-chip-wide);
  height: var(--size-chip-lg);
  border-radius: var(--radius-pill);
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  color: #fff;
  font-size: var(--font-hint);
  font-weight: 700;
  box-shadow: var(--shadow-chip);
}

.praise-sun__cloud {
  position: absolute;
  z-index: 0;
  top: 16rpx;
  right: 16rpx;
  width: 140rpx;
  height: 104rpx; /* 320×238 */
  pointer-events: none;
}

.praise-sun__grass {
  position: absolute;
  z-index: 0;
  bottom: -6rpx;
  left: 16rpx;
  width: 124rpx;
  height: 95rpx; /* 320×245 */
  pointer-events: none;
}

@keyframes praise-sun-in {
  to { opacity: 1; }
}

@keyframes praise-card-in {
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes praise-sun-out {
  to { opacity: 0; }
}

@keyframes praise-card-out {
  to {
    opacity: 0;
    transform: translateY(16rpx) scale(0.97);
  }
}
