<view class="app-shell {{night ? 'is-night' : ''}}">
  <view class="app-shell__sky"></view>
  <view class="scene" aria-hidden="true">
    <image class="scene__meadow" src="{{background}}" mode="widthFix" />
    <view class="scene__blend"></view>
    <view class="scene__dusk"></view>
  </view>
  <custom-header
    title="{{title}}"
    stars="{{stars}}"
    show-home="{{showHome}}"
    night="{{night}}"
    bind:home="onGoHome"
  />
  <view class="app-shell__body" style="padding-top: calc({{headerHeight}}px + 30rpx);">
    <view wx:if="{{hint}}" class="inner-head">
      <view class="inner-head__title">{{hint}}</view>
      <view wx:if="{{subHint}}" class="inner-head__sub">{{subHint}}</view>
    </view>
    <slot />
    <feedback-bar wx:if="{{barText}}" text="{{barText}}" type="{{barType}}" shake="{{barShake}}" />
  </view>
  <feedback-layer
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="onFeedbackContinue"
  />
</view>
