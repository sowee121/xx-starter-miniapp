.app-shell {
  position: relative;
  min-height: 100%;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
}

.app-shell.is-night {
  background: linear-gradient(180deg, var(--night-top) 0%, var(--night-mid) 58%, var(--night-deep) 100%);
}

.app-shell__sky {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 58%;
  z-index: 0;
  pointer-events: none;
}

.app-shell__bg {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
  /* 草地顶边淡出，兼容支持 mask 的基础库 */
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.18) 12%,
    rgba(0, 0, 0, 0.5) 22%,
    rgba(0, 0, 0, 0.82) 30%,
    #000 40%,
    #000 100%
  );
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.18) 12%,
    rgba(0, 0, 0, 0.5) 22%,
    rgba(0, 0, 0, 0.82) 30%,
    #000 40%,
    #000 100%
  );
}

.app-shell__body {
  position: relative;
  z-index: 1;
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--block-gap);
  padding: 0 var(--page-pad-x) calc(80rpx + env(safe-area-inset-bottom));
}

.app-shell.is-night .inner-head__title {
  color: var(--ink-night);
  text-shadow: 0 2rpx 8rpx rgba(12, 18, 46, 0.35);
}

.app-shell.is-night .inner-head__sub {
  color: var(--muted-night);
}
