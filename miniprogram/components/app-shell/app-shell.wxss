.app-shell {
  position: relative;
  min-height: 100%;
  width: 100%;
  overflow-x: hidden;
  overflow-y: visible;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
}

.app-shell.is-night {
  background: var(--night-top);
}

.app-shell__sky {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  height: 58%;
  z-index: 0;
  pointer-events: none;
}

.app-shell__body {
  position: relative;
  z-index: 1;
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: var(--gap-block);
  padding-left: var(--pad-page);
  padding-right: var(--pad-page);
  padding-bottom: var(--pad-page);
  padding-bottom: calc(var(--pad-page) + env(safe-area-inset-bottom, 0px));
}

/* 内页标题区（原全局 cards.wxss，仅本组件渲染） */
.inner-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-text);
}

.inner-head__title {
  font-size: var(--font-inner);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.inner-head__sub {
  font-size: var(--font-hint);
  color: var(--muted);
  white-space: nowrap;
  line-height: 1.3;
}

.app-shell.is-night .inner-head__title {
  color: var(--night-ink);
  text-shadow: 0 2rpx 8rpx rgba(12, 18, 46, 0.35);
}

.app-shell.is-night .inner-head__sub {
  color: var(--night-muted);
}
