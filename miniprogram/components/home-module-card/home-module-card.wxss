.home-module-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-text);
  width: 100%;
  height: 256rpx;
  padding: var(--pad-card-sm);
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-module-card:active {
  transform: scale(0.985);
}

.home-module-card__mascot {
  width: 168rpx;
  height: 168rpx;
  flex-shrink: 0;
}

.home-module-card__label {
  font-size: var(--font-body);
  font-weight: 700;
  line-height: 1.15;
  letter-spacing: 2rpx;
  color: var(--ink);
}
