:host {
  /* 宿主做块级占位，宽度由父容器 .entry-grid__cell 控制 */
  display: block;
}

/* 单张入口卡（english/hub、math/hub 共用），单列整行大卡，对齐 H5 blocks.css .entry-card */

.entry-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 420rpx;
  gap: var(--gap-row);
  padding: var(--pad-card);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

/* 色面：取值对齐全局 tone-sky/rose/sand；新增色调需在此补充 */
.entry-card--sky {
  background: var(--tone-sky);
  box-shadow: var(--shadow-tone-sky);
}

.entry-card--rose {
  background: var(--tone-rose);
  box-shadow: var(--shadow-tone-rose);
}

.entry-card--sand {
  background: var(--tone-sand);
  box-shadow: var(--shadow-tone-sand);
}

.entry-card__image {
  width: 240rpx;
  height: 240rpx;
}

.entry-card__title {
  font-size: var(--font-note);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.entry-card__sub {
  font-size: var(--font-title);
  color: var(--muted);
  line-height: 1.3;
}

.entry-card__desc {
  font-size: var(--font-hint);
  color: var(--muted);
  line-height: 1.4;
}
