.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: transparent;
  box-shadow: none;
}

.custom-header__row {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-inset);
  box-sizing: border-box;
  padding-left: 30rpx;
}

.custom-header__brand {
  flex: 1;
  min-width: 0;
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-header__right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-inset);
  flex-shrink: 0;
}

.custom-header__home,
.custom-header__home-spacer {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
}

.custom-header__home {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(145deg, #f7f9e9, #e6efd6);
  box-shadow: var(--shadow-clay-leaf);
}

.custom-header__home-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  transform: translateY(-4rpx);
}

.custom-header__title {
  flex: 1;
  min-width: 0;
  text-align: left;
  font-size: var(--font-title);
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--ink);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-header__page-stars {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
}

.custom-header.is-night .custom-header__title,
.custom-header.is-night .custom-header__brand {
  color: var(--ink-night);
  text-shadow: 0 2rpx 8rpx rgba(12, 18, 46, 0.35);
}

.custom-header.is-night .custom-header__home {
  background: linear-gradient(145deg, #f4f6fb, #c8d0ea);
  box-shadow: var(--shadow-clay-night);
}
