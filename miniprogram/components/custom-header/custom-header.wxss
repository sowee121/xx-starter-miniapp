.custom-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: transparent;
  box-shadow: none;
}

.custom-header__row {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
  padding-left: 30rpx;
}

.custom-header__brand {
  flex: 1;
  padding-right: 16rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
  color: #35553f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-header__right {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.custom-header__home,
.custom-header__home-spacer {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
}

.custom-header__home {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 38rpx;
  overflow: hidden;
  box-sizing: border-box;
  background: linear-gradient(145deg, #f7f9e9, #dce9c9);
  box-shadow:
    inset 0 3rpx 3rpx rgba(255, 255, 255, 0.88),
    inset 0 -3rpx 5rpx rgba(112, 145, 91, 0.14),
    0 8rpx 16rpx rgba(83, 112, 73, 0.16);
}

.custom-header__home-icon {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
}

.custom-header__title {
  position: absolute;
  left: 120rpx;
  right: 260rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #35553f;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-header__page-stars {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
}

.custom-header.is-night .custom-header__title,
.custom-header.is-night .custom-header__brand {
  color: #fffaf0;
  text-shadow: 0 2rpx 8rpx rgba(12, 18, 46, 0.35);
}

.custom-header.is-night .custom-header__home {
  border-color: rgba(220, 226, 250, 0.45);
  background: linear-gradient(145deg, #f4f6fb, #c8d0ea);
  box-shadow:
    inset 0 3rpx 3rpx rgba(255, 255, 255, 0.88),
    inset 0 -3rpx 5rpx rgba(72, 82, 140, 0.16),
    0 8rpx 16rpx rgba(18, 26, 57, 0.22);
}
