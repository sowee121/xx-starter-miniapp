.star-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-text);
  height: var(--size-star-bar);
  padding: 0 var(--gap-inset);
  box-sizing: border-box;
  flex-shrink: 0;
  border-radius: var(--radius-pill);
  background: var(--tone-leaf);
  box-shadow: var(--shadow-clay-leaf);
}

.star-bar__icon {
  flex-shrink: 0;
}

.star-bar__count {
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.star-bar.is-night {
  background: var(--tone-leaf-night);
  box-shadow: var(--shadow-clay-night);
}

.star-bar.is-night .star-bar__count {
  color: var(--night-strong);
}
