.star-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-text);
  padding: 0 24rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border-radius: var(--radius-pill);
  background: linear-gradient(145deg, #f7f9e9, #e6efd6);
  box-shadow: var(--shadow-clay-leaf);
}

.star-bar__icon {
  flex-shrink: 0;
}

.star-bar__count {
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.star-bar.is-night {
  background: linear-gradient(145deg, #f4f6fb, #c8d0ea);
  box-shadow: var(--shadow-clay-night);
}

.star-bar.is-night .star-bar__count {
  color: #3a426e;
}
