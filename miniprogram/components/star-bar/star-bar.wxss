.star-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-text);
  padding: 0 24rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border-radius: var(--radius-pill);
  background: linear-gradient(145deg, #f7f9e9, #e6efd6);
  box-shadow:
    var(--shadow-clay-hi),
    inset -4rpx -10rpx 16rpx rgba(112, 145, 91, 0.14),
    -2rpx 8rpx 14rpx rgba(83, 112, 73, 0.1),
    -2rpx 14rpx 22rpx rgba(83, 112, 73, 0.06);
}

.star-bar__icon {
  flex-shrink: 0;
}

.star-bar__count {
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.star-bar.is-night {
  background: linear-gradient(145deg, #f4f6fb, #c8d0ea);
  box-shadow: var(--shadow-clay-night);
}

.star-bar.is-night .star-bar__count {
  color: #3a426e;
}
