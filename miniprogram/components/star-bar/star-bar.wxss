.star-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  height: 68rpx;
  padding: 0 24rpx;
  flex-shrink: 0;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #fffdf7 0%, #fbf4e4 100%);
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.95),
    inset 0 -8rpx 14rpx rgba(198, 182, 146, 0.16),
    0 8rpx 16rpx rgba(96, 122, 96, 0.12);
  transition: transform 120ms ease-out, opacity 120ms ease-out;
}

/* 长按进入家长区期间的按压反馈，让家长确认手势已生效 */
.star-bar.is-pressing {
  transform: scale(0.92);
  opacity: 0.78;
}

.star-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.star-bar__count {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  color: #35553f;
}

.star-bar.is-night {
  background: linear-gradient(180deg, rgba(255, 250, 240, 0.96), rgba(232, 226, 250, 0.92));
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.55),
    inset 0 -8rpx 14rpx rgba(72, 82, 140, 0.14),
    0 8rpx 16rpx rgba(18, 26, 57, 0.22);
}

.star-bar.is-night .star-bar__count {
  color: #3a426e;
}
