<view
  class="hub-entry-card motion-tap hub-entry-card--{{tone}}"
  bindtap="onTap"
  hover-class="is-pressed"
  hover-start-time="0"
  hover-stay-time="80"
>
  <image class="hub-entry-card__image" src="{{image}}" mode="aspectFit" />
  <view class="hub-entry-card__title">{{title}}</view>
  <view class="hub-entry-card__sub">{{sub}}</view>
</view>
