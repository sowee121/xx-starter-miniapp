/* 单张入口卡（english/hub、math/hub 两列宫格共用） */

.hub-entry-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--col-2);
  min-height: 352rpx;
  gap: var(--gap-text);
  padding: var(--pad-card-sm);
  text-align: center;
  border-radius: var(--radius-tile);
  box-sizing: border-box;
  flex-shrink: 0;
  transition: var(--motion-tap);
}

.hub-entry-card:active {
  transform: scale(0.985);
}

/* 色面：取值对齐全局 tone-sky/rose/sand；新增色调需在此补充 */
.hub-entry-card--sky {
  background: var(--tone-sky);
  box-shadow: var(--shadow-tone-sky);
}

.hub-entry-card--rose {
  background: var(--tone-rose);
  box-shadow: var(--shadow-tone-rose);
}

.hub-entry-card--sand {
  background: var(--tone-sand);
  box-shadow: var(--shadow-tone-sand);
}

.hub-entry-card__image {
  width: 188rpx;
  height: 188rpx;
}

.hub-entry-card__title {
  font-size: var(--font-card);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.hub-entry-card__sub {
  font-size: var(--font-hint);
  color: var(--muted);
  line-height: 1.3;
}
