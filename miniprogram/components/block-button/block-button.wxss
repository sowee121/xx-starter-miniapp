/* 绿面写在组件内，避免自定义组件吃不到 app 里的渐变变量 */
:host {
  /* 宿主占满父容器宽，绿 CTA 通栏 */
  display: block;
  width: 100%;
}

.block-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 0;
  font-weight: 700;
  color: #ffffff;
  border-radius: var(--radius-pill);
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
  box-sizing: border-box;
  width: 100%;
  height: var(--size-slot);
  font-size: var(--font-card);
  gap: var(--gap-inner);
}

.block-btn__text {
  color: #ffffff;
  font-size: var(--font-card);
  font-weight: 700;
  line-height: 1.2;
}
