<view wx:if="{{visible}}" class="feedback-layer {{closingState}}" bindtap="onContinue">
  <view
    class="feedback-layer__card {{variant === 'fail' ? 'is-fail' : ''}} {{variant === 'exchange' ? 'is-exchange' : ''}}"
    catchtap="onCardTap"
  >
    <image class="feedback-layer__cloud" src="{{cloudIcon}}" mode="aspectFit" />
    <view class="feedback-layer__icon-slot">
      <image class="feedback-layer__icon" src="{{image || starIcon}}" mode="aspectFit" />
    </view>
    <view class="feedback-layer__body">
      <view class="feedback-layer__text">{{title}}</view>
      <view class="feedback-layer__desc">{{desc}}</view>
    </view>
    <view
      class="feedback-layer__continue motion-tap"
      catchtap="onContinue"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="80"
      >{{actionLabel}}</view
    >
    <image class="feedback-layer__grass" src="{{grassIcon}}" mode="aspectFit" />
  </view>
</view>
