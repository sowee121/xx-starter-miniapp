.feedback-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: var(--letter-btn); /* 全站字距；弹层样式隔离需自写 */
  background: rgba(65, 87, 75, 0.22);
  perspective: 800rpx; /* 透视越近，rotateX 立起的纵深越夸张 */
  animation: feedback-layer-in 320ms ease-out; /* 不留 fill：播完回落静态显示态，出场走纯静态 transition */
  transition: opacity 460ms ease-in-out; /* 出场淡出走 transition，避免动画替换不重播 */
}

.feedback-layer__card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-block);
  width: var(--size-layer);
  min-height: var(--size-layer-min);
  padding: var(--pad-card-xl);
  border-radius: var(--radius-card);
  box-sizing: border-box;
  overflow: hidden;
  text-align: center;
  background: var(--tone-cream);
  box-shadow: var(--shadow-clay-layer);
  /* 基础态=显示态：出场收起由 transition 从显示态过渡，不依赖动画 fill 状态 */
  transform-origin: center 50%; /* 翻转轴在卡片高度一半，上下对称翻出 */
  /* opacity 与 transform 拆开：fade 320ms 快速落满，rise 单区间缓落翻正。
     不去中间帧就不会产生区间速度跳变（前段减速近停→后段猛启动），翻转全程连续丝滑 */
  animation:
    feedback-card-fade 320ms ease-out,
    feedback-card-rise 800ms cubic-bezier(0.4, 0, 0.2, 1); /* 不留 fill：播完回落静态显示态 */
  transition:
    transform 460ms ease-in-out,
    opacity 460ms ease-in-out; /* 出场原路翻回走 transition */
}

/* 出场走「终态类 + transition」：解除入场动画 fill 后改到收起终值，
   由基础 transition 过渡，不依赖动画替换重播，真机表现稳定 */
.feedback-layer.is-closing {
  animation: none;
  opacity: 0;
}

.feedback-layer.is-closing .feedback-layer__card {
  animation: none; /* 摘掉入场动画，让 transform/opacity 交给 transition */
  opacity: 0;
  transform: rotateX(88deg) translateY(70rpx) scale(0.92); /* 原路翻回垂直成缝 */
}

.feedback-layer__card.is-fail {
  background: var(--tone-fail);
}

.feedback-layer__card.is-fail .feedback-layer__text {
  color: var(--note);
}

.feedback-layer__card.is-exchange {
  background: var(--tone-rose);
}

.feedback-layer__card.is-exchange .feedback-layer__text {
  color: #7a4f63;
}

.feedback-layer__icon-slot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size-layer-icon);
  height: var(--size-layer-icon);
  flex-shrink: 0;
}

.feedback-layer__icon {
  display: block;
  width: var(--size-layer-icon);
  height: var(--size-layer-icon);
  vertical-align: middle;
}

.feedback-layer__body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-inner);
}

.feedback-layer__text {
  font-size: var(--font-display);
  color: var(--ink);
  font-weight: 700;
  line-height: 1.2;
}

.feedback-layer__desc {
  color: var(--muted);
  font-size: var(--font-hint);
  line-height: 1.3;
}

.feedback-layer__continue {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size-chip-wide);
  height: var(--size-chip-lg);
  border-radius: var(--radius-pill);
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  color: #fff;
  font-size: var(--font-hint);
  font-weight: 700;
  box-shadow: var(--shadow-chip);
}

.feedback-layer__cloud {
  position: absolute;
  z-index: 0;
  top: 16rpx;
  right: 16rpx;
  width: 140rpx;
  height: 104rpx; /* 320×238 */
  pointer-events: none;
}

.feedback-layer__grass {
  position: absolute;
  z-index: 0;
  bottom: -6rpx;
  left: 16rpx;
  width: 124rpx;
  height: 95rpx; /* 320×245 */
  pointer-events: none;
}

@keyframes feedback-layer-in {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}

@keyframes feedback-card-fade {
  0% {
    opacity: 0;
  }
  100% {
    opacity: 1;
  }
}
@keyframes feedback-card-rise {
  0% {
    transform: rotateX(88deg) translateY(70rpx) scale(0.92); /* 垂直屏幕成一条缝 */
  }
  100% {
    transform: rotateX(0) translateY(0) scale(1); /* 单区间缓落，速度连续不卡顿 */
  }
}
