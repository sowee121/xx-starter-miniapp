<view wx:if="{{show}}" class="trail-nav is-step" aria-label="{{label}}">
  <view
    class="trail-nav__item motion-tap {{hasPrev ? '' : 'is-disabled'}}"
    bindtap="onPrev"
    hover-class="is-pressed"
    hover-start-time="0"
    hover-stay-time="80"
    aria-label="上一题"
  >
    <image class="trail-nav__arrow is-flip" src="/static/shared/arrow.png" mode="aspectFit" />
  </view>
  <view
    class="trail-nav__item motion-tap {{hasNext ? '' : 'is-disabled'}}"
    bindtap="onNext"
    hover-class="is-pressed"
    hover-start-time="0"
    hover-stay-time="80"
    aria-label="下一题"
  >
    <image class="trail-nav__arrow" src="/static/shared/arrow.png" mode="aspectFit" />
  </view>
</view>
