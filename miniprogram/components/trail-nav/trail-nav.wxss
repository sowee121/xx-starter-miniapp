/* 通用石子径：详情切项（单字石子）/ 上下步（箭头），本组件自包含，不依赖全局公共样式 */
.trail-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--gap-trail);
  box-sizing: border-box;
}

.trail-nav.is-step {
  justify-content: stretch;
  gap: var(--gap-block);
}

.trail-nav.is-step .trail-nav__item {
  flex: 1;
  width: auto;
  min-width: 0;
  height: var(--size-slot);
  border-radius: var(--radius-pill);
  /* 跟组词 / 诗行 / 例句同一套奶油黏土面，不要石子径冷灰绿 */
  background: var(--tone-cream);
  box-shadow: var(--shadow-clay);
}

.trail-nav.is-step .trail-nav__arrow {
  width: var(--size-arrow);
  height: var(--size-arrow);
}

.trail-nav__item {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--size-trail);
  height: var(--size-trail);
  /* 单字默认正圆 */
  border-radius: var(--radius-pill);
  border: 0;
  background: var(--tone-trail);
  box-shadow: var(--shadow-trail);
  font-size: var(--font-trail);
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
  text-decoration: none;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 墨水区相对字盒偏下：只上移字形，不挪动石子圆面 */
.trail-nav__glyph {
  display: block;
  line-height: 1;
  transform: translateY(-0.08em);
}

.trail-nav__arrow {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.trail-nav__arrow.is-flip {
  transform: scaleX(-1);
}

.trail-nav__item.is-current {
  background: var(--tone-ok);
  box-shadow: var(--shadow-trail-current);
}
