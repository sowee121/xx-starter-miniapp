/* 石子径：上下步（上一个/下一个箭头），本组件自包含，不依赖全局公共样式 */
.trail-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--gap-trail);
  box-sizing: border-box;
}

.trail-nav.is-step {
  justify-content: stretch;
  gap: var(--gap-block);
}

.trail-nav.is-step .trail-nav__item {
  flex: 1;
  width: auto;
  min-width: 0;
  height: var(--size-slot);
  border-radius: var(--radius-pill);
  /* 跟组词 / 诗行 / 例句同一套奶油黏土面，不要石子径冷灰绿 */
  background: var(--tone-cream);
  box-shadow: var(--shadow-clay);
}

.trail-nav__item {
  position: relative;
  display: grid;
  place-items: center;
  border: 0;
  box-sizing: border-box;
  flex-shrink: 0;
}

.trail-nav.is-step .trail-nav__arrow {
  width: var(--size-arrow);
  height: var(--size-arrow);
}

.trail-nav__arrow {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.trail-nav__arrow.is-flip {
  transform: scaleX(-1);
}
