<view class="entry-grid">
  <view wx:for="{{cards}}" wx:key="to" class="entry-grid__cell">
    <entry-card
      image="{{item.image}}"
      title="{{item.title}}"
      sub="{{item.sub}}"
      desc="{{item.desc}}"
      tone="{{item.tone}}"
      to="{{item.to}}"
      bind:go="onCardGo"
    />
  </view>
</view>
