/* 学习主卡样式：详情大图 / 标题 / 释义 */

.detail-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-block);
  padding: var(--pad-card-xl);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.detail-card__image {
  width: 320rpx;
  height: 320rpx;
}

/* 韵母 / 字母宽图：卡图超出默认 320rpx 的加宽尺寸 */
.detail-card__image--wide {
  width: 360rpx;
  height: 360rpx;
}

.detail-card__emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size-emoji-lg);
  height: var(--size-emoji-lg);
  font-size: var(--font-emoji-lg);
  line-height: 1;
}

.detail-card__glyph {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.detail-card__title {
  font-size: var(--font-inner);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.detail-card__sub {
  font-size: var(--font-hint);
  color: var(--muted);
  line-height: 1.3;
}

.detail-card__meaning {
  font-size: var(--font-note);
  font-weight: 700;
  color: var(--ink);
}
