<view class="hub-entry-cards">
  <view
    wx:for="{{cards}}"
    wx:key="to"
    class="hub-entry-card hub-entry-card--{{item.tone}}"
    data-to="{{item.to}}"
    bindtap="onCardTap"
    hover-class="is-pressed"
    hover-start-time="0"
    hover-stay-time="80"
  >
    <image class="hub-entry-card__image" src="{{item.image}}" mode="aspectFit" />
    <view class="hub-entry-card__title">{{item.title}}</view>
    <view class="hub-entry-card__sub">{{item.sub}}</view>
  </view>
</view>
