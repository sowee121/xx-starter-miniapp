<view class="hub-entry-cards">
  <view wx:for="{{cards}}" wx:key="to" class="hub-entry-cards__cell">
    <hub-entry-card
      image="{{item.image}}"
      title="{{item.title}}"
      sub="{{item.sub}}"
      tone="{{item.tone}}"
      to="{{item.to}}"
      bind:go="onCardGo"
    />
  </view>
</view>
