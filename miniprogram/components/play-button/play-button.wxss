/* 圆钮视觉只写在本组件，播放/停止位移不再散落全局 */

.play-btn-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: var(--size-tap);
  min-height: var(--size-tap-compact);
  box-sizing: border-box;
}

.play-btn-hit.is-flush {
  min-width: 0;
  min-height: 0;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--size-play);
  height: var(--size-play);
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 50%;
  background-color: var(--btn-green-solid);
  background-image: var(--btn-play);
  box-shadow: var(--shadow-play);
}

.play-btn__icon {
  display: block;
  width: var(--size-play-icon);
  height: var(--size-play-icon);
  margin-left: 0;
  transform: translateX(2rpx);
}

.play-btn.is-lg {
  width: var(--size-play-lg);
  height: var(--size-play-lg);
}

.play-btn.is-lg .play-btn__icon {
  width: var(--size-play-icon-lg);
  height: var(--size-play-icon-lg);
}

.play-btn.is-sm {
  width: var(--size-play-sm);
  height: var(--size-play-sm);
}

.play-btn.is-sm .play-btn__icon {
  width: var(--size-play-icon-sm);
  height: var(--size-play-icon-sm);
}

.play-btn.is-playing .play-btn__icon {
  transform: translateX(1rpx);
}
