/* 圆钮视觉只写在本组件，播放/停止位移不再散落全局 */

.play-btn-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: var(--tap-min);
  min-height: var(--tap-min-compact);
  box-sizing: border-box;
}

.play-btn-hit.is-flush {
  min-width: 0;
  min-height: 0;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 46rpx;
  background-color: #77b07c;
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.play-btn__icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  margin-left: 0;
  transform: translateX(2rpx);
}

.play-btn.is-lg {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
}

.play-btn.is-lg .play-btn__icon {
  width: 54rpx;
  height: 54rpx;
}

.play-btn.is-sm {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
}

.play-btn.is-sm .play-btn__icon {
  width: 36rpx;
  height: 36rpx;
}

.play-btn.is-playing .play-btn__icon {
  transform: translateX(1rpx);
}
