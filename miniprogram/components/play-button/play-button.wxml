<view
  wx:if="{{passive}}"
  class="play-btn-hit custom-class"
  aria-role="button"
  aria-label="{{playing ? '停止' : '播放'}}"
>
  <view
    class="play-btn {{size === 'lg' ? 'is-lg' : ''}} {{size === 'sm' ? 'is-sm' : ''}} {{playing ? 'is-playing' : ''}}"
  >
    <view class="play-btn__flip {{playing ? 'is-flipped' : ''}}">
      <image class="play-btn__icon play-btn__icon--front" src="{{playIcon}}" mode="aspectFit" />
      <image class="play-btn__icon play-btn__icon--back" src="{{stopIcon}}" mode="aspectFit" />
    </view>
  </view>
</view>
<view
  wx:else
  class="play-btn-hit custom-class"
  catchtap="onTap"
  aria-role="button"
  aria-label="{{playing ? '停止' : '播放'}}"
  hover-class="is-pressed"
  hover-start-time="0"
  hover-stay-time="80"
>
  <view
    class="play-btn {{size === 'lg' ? 'is-lg' : ''}} {{size === 'sm' || compact ? 'is-sm' : ''}} {{playing ? 'is-playing' : ''}}"
  >
    <view class="play-btn__flip {{playing ? 'is-flipped' : ''}}">
      <image class="play-btn__icon play-btn__icon--front" src="{{playIcon}}" mode="aspectFit" />
      <image class="play-btn__icon play-btn__icon--back" src="{{stopIcon}}" mode="aspectFit" />
    </view>
  </view>
</view>
