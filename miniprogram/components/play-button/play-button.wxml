<view
  wx:if="{{passive}}"
  class="play-btn-hit is-flush custom-class"
  aria-role="button"
  aria-label="播放"
>
  <view
    class="play-btn {{size === 'lg' ? 'is-lg' : ''}} {{size === 'sm' ? 'is-sm' : ''}}"
  >
    <image class="play-btn__icon" src="{{playIcon}}" mode="aspectFit" />
  </view>
</view>
<view
  wx:else
  class="play-btn-hit {{compact ? 'is-flush' : ''}} custom-class"
  catchtap="onTap"
  aria-role="button"
  aria-label="播放"
>
  <view
    class="play-btn {{size === 'lg' ? 'is-lg' : ''}} {{size === 'sm' || compact ? 'is-sm' : ''}}"
  >
    <image class="play-btn__icon" src="{{playIcon}}" mode="aspectFit" />
  </view>
</view>
