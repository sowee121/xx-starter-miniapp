<app-shell title="拼音" hint="单韵母" sub-hint="听一听小声音" stars="{{stars}}">
  <view class="word-grid">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="word-card block tone-lilac"
      data-id="{{item.id}}"
      bindtap="open"
    >
      <image class="word-card__image" src="{{item.image}}" mode="aspectFit" />
      <view class="play-btn is-sm">
        <image class="play-btn__icon" src="/static/shared/play.png" mode="aspectFit" />
      </view>
    </view>
  </view>
</app-shell>
