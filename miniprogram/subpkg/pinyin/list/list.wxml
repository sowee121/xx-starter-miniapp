<app-shell title="拼音" hint="单韵母" sub-hint="听一听小声音" stars="{{stars}}">
  <view class="word-grid">
    <view
      wx:for="{{items}}"
      wx:key="id"
      class="word-card block tone-cream"
      data-id="{{item.id}}"
      bindtap="open" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">
      <image class="word-card__image" src="{{item.image}}" mode="aspectFit" lazy-load />
      <play-button size="sm" passive="{{true}}" />
    </view>
  </view>
</app-shell>
