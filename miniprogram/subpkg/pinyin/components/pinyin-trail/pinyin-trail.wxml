<view class="trail-nav" aria-label="{{label}}">
  <view
    wx:for="{{trail}}"
    wx:key="id"
    class="trail-nav__item {{item.current ? 'is-current' : ''}}"
    data-id="{{item.id}}"
    bindtap="onTap"
    hover-class="is-pressed"
    hover-start-time="0"
    hover-stay-time="80"
  ><text class="trail-nav__glyph">{{item.letter}}</text></view>
</view>
