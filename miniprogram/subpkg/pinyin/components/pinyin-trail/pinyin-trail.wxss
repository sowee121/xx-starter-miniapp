/* 拼音石子径：纵向侧边 is-step 箭头导航，本组件自包含，不依赖全局公共样式 */
.trail-nav {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
  gap: var(--gap-block);
  box-sizing: border-box;
}

.trail-nav.is-step {
  justify-content: stretch;
}

.trail-nav__item {
  position: relative;
  display: grid;
  place-items: center;
  box-sizing: border-box;
}

.trail-nav.is-step .trail-nav__item {
  flex: 1;
  width: auto;
  min-width: 0;
  height: var(--size-slot);
  border-radius: var(--radius-pill);
  /* 跟组词 / 诗行 / 例句同一套奶油黏土面 */
  background: var(--tone-cream);
  box-shadow: var(--shadow-clay);
}

.trail-nav__arrow {
  width: var(--size-arrow);
  height: var(--size-arrow);
  display: block;
}

.trail-nav__arrow.is-flip {
  transform: scaleX(-1);
}
