/* 拼音韵母石子径：独立 class，不复用通用 trail-nav 的样式 */
.pinyin-trail {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--gap-trail);
  box-sizing: border-box;
}

.pinyin-trail__item {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--size-trail);
  height: var(--size-trail);
  border-radius: var(--radius-pill);
  border: 0;
  background: var(--tone-trail);
  box-shadow: var(--shadow-trail);
  font-size: var(--font-trail);
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
  text-decoration: none;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 墨水区相对字盒偏下：只上移字形，不挪动石子圆面 */
.pinyin-trail__glyph {
  display: block;
  line-height: 1;
  transform: translateY(-0.08em);
}

.pinyin-trail__item.is-current {
  background: var(--tone-ok);
  box-shadow: var(--shadow-trail-current);
}

.pinyin-trail__item.is-disabled {
  opacity: 0.45;
}
