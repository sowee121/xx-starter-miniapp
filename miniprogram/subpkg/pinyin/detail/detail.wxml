<app-shell
  title="拼音"
  stars="{{stars}}"
  feedback="{{feedback}}"
  soft-note="{{softNote}}"
  bind:continue="closeFeedback"
>
  <view wx:if="{{item}}" class="detail-stack">
    <view
      class="detail-big block tone-cream"
      bindtap="play"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <image class="pinyin-vowel-image" src="{{item.image}}" mode="aspectFit" lazy-load />
      <view class="detail-big__sub">{{item.phonetic}}</view>
      <play-button size="lg" passive="{{true}}" playing="{{playingSrc === item.audio}}" />
    </view>

    <view class="buddy-dock block tone-cream">
      <image class="buddy-dock__mascot" src="{{buddyIcon}}" mode="aspectFit" lazy-load />
      <view class="buddy-dock__bubble">
        <view class="buddy-dock__bubble-tail" aria-hidden="true"></view>
        <text class="buddy-dock__bubble-text">{{item.hint}}</text>
      </view>
    </view>

    <view class="trail-nav" aria-label="韵母石子径">
      <view
        wx:for="{{trail}}"
        wx:key="id"
        class="trail-nav__item {{item.current ? 'is-current' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTrailTap"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="80"
        ><text class="trail-nav__glyph">{{item.letter}}</text></view
      >
    </view>
  </view>
</app-shell>
