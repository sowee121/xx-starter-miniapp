<app-shell
  title="拼音"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bar-text="{{barText}}"
  bind:continue="closeFeedback"
>
  <view wx:if="{{item}}" class="detail-stack">
    <detail-card
      tone="cream"
      image="{{item.image}}"
      image-class="detail-card__image--wide"
      sub="{{item.phonetic}}"
      playing="{{playingSrc === item.audio}}"
      bindtap="play"
    />

    <buddy-dock icon="{{buddyIcon}}" text="{{item.hint}}" tone="cream" />

    <pinyin-trail
      trail="{{trail}}"
      label="韵母石子径"
      bind:tap="onTrailTap"
    />
  </view>
</app-shell>
