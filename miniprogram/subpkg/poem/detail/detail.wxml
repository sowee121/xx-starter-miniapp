<app-shell
  title="古诗"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bar-text="{{barText}}"
  bind:continue="closeFeedback"
>
  <view class="page-list" wx:if="{{poem}}">
    <hero-card
      tone="{{poem.tone}}"
      image="{{poem.icon}}"
      title="{{poem.title}}"
      author="{{poem.author}}"
      playing="{{playingSrc === poem.fullAudio}}"
      bindtap="onFullPlay"
    />

    <word-row
      wx:for="{{poem.lines}}"
      wx:key="text"
      text="{{item.text}}"
      active="{{playingSrc === item.audio}}"
      playing="{{playingSrc === item.audio}}"
      data-index="{{index}}"
      bindtap="onLineTap"
    />

    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
  </view>
</app-shell>
