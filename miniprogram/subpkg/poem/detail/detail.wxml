<app-shell
  title="古诗"
  stars="{{stars}}"
  feedback="{{feedback}}"
  soft-note="{{softNote}}"
  bind:continue="closeFeedback"
>
  <view class="page-list" wx:if="{{poem}}">
    <view
      class="hero block tone-{{poem.tone}}"
      bindtap="onFullPlay"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <image class="hero__image" src="{{poem.icon}}" mode="widthFix" lazy-load />
      <view class="hero__bar">
        <view class="hero__heading">
          <view class="hero__title">{{poem.title}}</view>
          <view class="hero__sub">{{poem.author}}</view>
        </view>
        <view class="hero__play">
          <play-button size="lg" playing="{{playingSrc === poem.fullAudio}}" passive="{{true}}" />
        </view>
      </view>
    </view>

    <word-line
      wx:for="{{poem.lines}}"
      wx:key="text"
      text="{{item.text}}"
      active="{{playingSrc === item.audio}}"
      playing="{{playingSrc === item.audio}}"
      data-index="{{index}}"
      bindtap="onLineTap"
    />

    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
  </view>
</app-shell>
