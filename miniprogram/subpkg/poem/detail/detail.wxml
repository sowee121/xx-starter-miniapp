<app-shell title="古诗" stars="{{stars}}">
  <view class="page-list" wx:if="{{poem}}">
    <view class="hero block tone-{{poem.tone}}" bindtap="onFullPlay" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">
      <image class="hero__image" src="{{poem.icon}}" mode="widthFix" lazy-load />
      <view class="hero__bar">
        <view class="hero__title">{{poem.title}}</view>
        <view class="hero__sub">{{poem.author}}</view>
        <view class="hero__play">
          <play-button size="lg" playing="{{longPlaying}}" passive="{{true}}" />
        </view>
      </view>
    </view>

    <view
      wx:for="{{poem.lines}}"
      wx:key="text"
      class="poem-line block tone-cream {{activeIndex === index ? 'is-active' : ''}}"
      data-index="{{index}}"
      bindtap="onLineTap" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="poem-line__text">{{item.text}}</view>
      <view class="media-play">
        <play-button compact="{{true}}" passive="{{true}}" />
      </view>
    </view>

    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
    <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="closePraise"
  />
</app-shell>
