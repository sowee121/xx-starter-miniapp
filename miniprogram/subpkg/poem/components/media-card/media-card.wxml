<view
  class="media-card motion-tap block tone-{{tone || 'cream'}} custom-class"
  bindtap="onTap"
  hover-class="is-pressed"
  hover-start-time="0"
  hover-stay-time="80"
>
  <view class="media-main">
    <view
      wx:if="{{image}}"
      class="media-main__thumb {{wideImage ? 'media-main__thumb--wide' : ''}}"
    >
      <image class="media-main__image" src="{{image}}" mode="aspectFit" lazy-load />
    </view>
    <view class="media-main__body">
      <view class="media-main__title">{{title}}</view>
      <view wx:if="{{subtitle}}" class="media-main__sub">{{subtitle}}</view>
    </view>
  </view>
  <view wx:if="{{play}}" class="media-play">
    <play-button passive="{{true}}" />
  </view>
  <view wx:if="{{meta || metaIcon}}" class="media-card__meta">
    <image wx:if="{{metaIcon}}" class="media-card__meta-icon" src="{{metaIcon}}" mode="aspectFit" />
    <view wx:if="{{meta}}" class="media-card__meta-text">{{meta}}</view>
  </view>
</view>
