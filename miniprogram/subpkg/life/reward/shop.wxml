<app-shell title="积分商城" hint="动物贴纸" sub-hint="用星星兑换喜欢的贴纸" stars="{{stars}}">
  <view class="sticker-grid">
    <view
      wx:for="{{stickers}}"
      wx:key="id"
      class="sticker-card block tone-{{item.tone}} {{item.owned ? 'is-owned' : ''}}"
    >
      <image class="sticker-card__image" src="{{item.image}}" mode="aspectFit" lazy-load />
      <view class="sticker-card__price">
        <view>{{item.cost}}</view>
        <image src="/static/home/star.png" mode="aspectFit" />
      </view>
      <view
        class="chip is-compact {{item.owned ? 'is-owned' : (!item.affordable ? 'is-short' : '')}}"
        data-id="{{item.id}}"
        catchtap="onExchange"
      >
        {{item.owned ? '已拥有' : (item.affordable ? '兑换' : '星星不足')}}
      </view>
    </view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    bind:continue="closePraise"
  />
</app-shell>
