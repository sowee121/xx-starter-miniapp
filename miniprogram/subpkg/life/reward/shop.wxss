.sticker-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  box-sizing: border-box;
  width: 100%;
  gap: var(--block-gap);
}

.sticker-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: var(--gap-text);
  width: var(--col-3);
  min-height: 312rpx;
  padding: var(--pad-card-sm);
  border-radius: var(--radius-tile);
  text-align: center;
  box-sizing: border-box;
}

.sticker-card__image {
  width: 100%;
  height: auto;
  aspect-ratio: 1;
  border-radius: var(--radius-thumb);
}

.sticker-card__price {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--gap-snug);
  min-height: var(--star-icon);
  color: #9b7646;
  font-size: var(--font-nav);
  font-weight: 700;
}

.sticker-card .chip.is-compact {
  align-self: stretch;
  width: 100%;
  min-width: 0;
  margin-top: 0;
}

.sticker-card__price image {
  width: var(--star-icon);
  height: var(--star-icon);
}
