.task-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-inset);
  min-height: 152rpx;
  padding: var(--pad-card);
  border-radius: var(--radius-tile);
  box-sizing: border-box;
  transition: var(--motion-tap);
}

.task-row:active {
  transform: scale(0.985);
}

.task-row__tick {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: rgba(126, 160, 116, 0.22);
  box-shadow:
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.28),
    inset 0 -4rpx 8rpx rgba(96, 122, 96, 0.12);
  flex-shrink: 0;
  transition: var(--motion-tap);
}

.is-done .task-row__tick {
  background-color: #77b07c;
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.task-row__check {
  width: 56rpx;
  height: 56rpx;
}

.task-row__body {
  padding-right: 8rpx;
}

.task-row__title {
  font-size: var(--font-body);
  font-weight: 700;
  color: var(--ink);
}

.task-row__progress {
  font-size: var(--font-hint);
  font-weight: 600;
  color: rgba(53, 85, 63, 0.62);
}

.task-row__reward {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-text);
  font-size: var(--font-hint);
  font-weight: 700;
  color: #b78245;
  flex-shrink: 0;
}

.task-row__reward image {
  width: var(--star-icon);
  height: var(--star-icon);
}
