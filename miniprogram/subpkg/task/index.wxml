<app-shell title="每日任务" hint="{{pageHint}}" sub-hint="{{pageSubHint}}" stars="{{stars}}">
  <view class="page-list">
    <task-row
      wx:for="{{tasks}}"
      wx:key="id"
      task-id="{{item.id}}"
      title="{{item.title}}"
      done="{{item.done}}"
      show-progress="{{item.showProgress}}"
      current="{{item.current}}"
      target="{{item.target}}"
      reward="{{item.reward}}"
      bind:tap="onTaskTap"
    />
  </view>
</app-shell>
