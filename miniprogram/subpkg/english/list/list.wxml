<app-shell title="英语" hint="单词" sub-hint="听一听，说一说" stars="{{stars}}">
  <view class="section" wx:for="{{categories}}" wx:key="id">
    <view class="section-title">{{item.title}}</view>
    <view class="word-grid">
      <view
        wx:for="{{item.items}}"
        wx:for-item="word"
        wx:key="word"
        class="word-card word-card--english block tone-{{item.tone}}"
        data-word="{{word.word}}"
        data-cat="{{item.id}}"
        bindtap="open"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <image class="word-card__image" src="{{word.image}}" mode="aspectFit" lazy-load />
        <view class="word-card__label">{{word.word}}</view>
      </view>
    </view>
  </view>
</app-shell>
