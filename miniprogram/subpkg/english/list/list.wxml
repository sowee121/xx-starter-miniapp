<app-shell title="英语" hint="单词" sub-hint="听一听，学单词" stars="{{stars}}">
  <view class="section" wx:for="{{categories}}" wx:key="id">
    <view class="section-title">{{item.title}}</view>
    <view class="word-grid">
      <word-card
        wx:for="{{item.items}}"
        wx:for-item="word"
        wx:key="word"
        image="{{word.image}}"
        label="{{word.word}}"
        play="{{false}}"
        cls="word-card--english tone-{{item.tone}}"
        data-word="{{word.word}}"
        data-cat="{{item.id}}"
        bindtap="open"
      />
    </view>
  </view>
</app-shell>
