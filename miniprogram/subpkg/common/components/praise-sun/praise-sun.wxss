.praise-sun {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(65, 87, 75, 0.22);
}

.praise-sun__card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  width: 620rpx;
  min-height: 720rpx;
  padding: 70rpx 40rpx 56rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
  overflow: hidden;
  text-align: center;
  background: linear-gradient(180deg, #fffdf7 0%, #f9f2e2 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(198, 182, 146, 0.16),
    var(--shadow);
}

.praise-sun__icon-slot {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 260rpx;
  height: 260rpx;
  flex-shrink: 0;
}

.praise-sun__icon {
  display: block;
  width: 260rpx;
  height: 260rpx;
  vertical-align: middle;
}

.praise-sun__copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.praise-sun__text {
  display: block;
  font-size: 58rpx;
  color: #35553f;
  font-weight: 700;
  line-height: 1.2;
}

.praise-sun__desc {
  display: block;
  color: #6e8f76;
  font-size: 30rpx;
  line-height: 1.3;
}

.praise-sun__continue {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  width: 168rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(180deg, #93c496, #77b07c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: var(--shadow-chip);
}

.praise-sun__cloud {
  position: absolute;
  z-index: 0;
  top: 16rpx;
  right: 16rpx;
  width: 140rpx;
  height: 104rpx;
  opacity: 0.86;
  pointer-events: none;
}

.praise-sun__grass {
  position: absolute;
  z-index: 0;
  bottom: -5rpx;
  left: 16rpx;
  width: 124rpx;
  height: 95rpx;
  opacity: 0.86;
  pointer-events: none;
}
