.sticker-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  box-sizing: border-box;
  width: 100%;
  gap: var(--gap-grid);
}

.sticker-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: var(--gap-text);
  width: var(--col-3);
  min-height: 312rpx;
  padding: var(--pad-card-sm);
  border-radius: var(--radius-tile);
  text-align: center;
  box-sizing: border-box;
}

.sticker-card.is-album {
  min-height: 0;
}

.sticker-card__image {
  width: 168rpx;
  height: 168rpx;
  align-self: center;
  border-radius: var(--radius-thumb);
}

.sticker-card__name {
  font-size: var(--font-nav);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.sticker-card__price {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--gap-snug);
  min-height: var(--size-star);
  color: #9b7646;
  font-size: var(--font-nav);
  font-weight: 700;
}

.sticker-card .chip.is-compact {
  align-self: stretch;
  width: 100%;
  min-width: 0;
  margin-top: 0;
}

.sticker-card__price image {
  width: var(--size-star);
  height: var(--size-star);
}

.album-hint {
  width: 100%;
  text-align: center;
  font-size: var(--font-hint);
  color: var(--muted);
}
