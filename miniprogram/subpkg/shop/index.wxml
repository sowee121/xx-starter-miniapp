<app-shell
  title="积分商城"
  hint="动物贴纸"
  sub-hint="用星星兑换喜欢的贴纸"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bind:continue="closeFeedback"
>
  <view class="section">
    <view class="section-title">我的贴纸</view>
    <view wx:if="{{mine.length}}" class="sticker-grid">
      <sticker-card
        wx:for="{{mine}}"
        wx:key="id"
        mode="album"
        name="{{item.name}}"
        image="{{item.image}}"
        tone="{{item.tone}}"
      />
    </view>
    <view wx:else class="album-hint">去兑换小动物吧～</view>
  </view>

  <view class="section">
    <view class="section-title">兑换贴纸</view>
    <view wx:if="{{shop.length}}" class="sticker-grid">
      <sticker-card
        wx:for="{{shop}}"
        wx:key="id"
        mode="shop"
        name="{{item.name}}"
        image="{{item.image}}"
        tone="{{item.tone}}"
        cost="{{item.cost}}"
        affordable="{{item.affordable}}"
        sticker-id="{{item.id}}"
        bind:exchange="onExchange"
      />
    </view>
    <view wx:else class="album-hint">全部集齐啦～</view>
  </view>
</app-shell>
