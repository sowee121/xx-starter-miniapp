<app-shell
  title="英语"
  hint="字母表"
  sub-hint="听一听，学字母"
  stars="{{stars}}"
  bar-text="{{barText}}"
>
  <view class="word-grid">
    <word-card
      wx:for="{{items}}"
      wx:key="letter"
      image="{{item.image}}"
      cls="tone-sky"
      data-letter="{{item.letter}}"
      bindtap="open"
    />
    <word-card
      cls="is-song tone-sky"
      image="{{songImage}}"
      playing="{{playingSrc === songSrc}}"
      catchtap="toggleSong"
    />
  </view>
</app-shell>
