<app-shell title="英语" hint="字母表" sub-hint="听一听字母" stars="{{stars}}">
  <view class="word-grid">
    <view
      wx:for="{{items}}"
      wx:key="letter"
      class="word-card block tone-sky"
      data-letter="{{item.letter}}"
      bindtap="open" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">
      <image class="word-card__image" src="{{item.image}}" mode="aspectFit" lazy-load />
      <play-button size="sm" passive="{{true}}" />
    </view>
    <view class="word-card is-song block tone-sky" catchtap="toggleSong" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">
      <image class="word-card__image" src="{{songImage}}" mode="aspectFit" lazy-load />
      <play-button size="sm" passive="{{true}}" playing="{{playingSrc === songSrc}}" />
    </view>
  </view>
  <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
</app-shell>
