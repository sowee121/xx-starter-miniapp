<app-shell title="英语" stars="{{stars}}">
  <view wx:if="{{item}}" class="detail-stack {{nav.total > 1 ? 'is-docked' : ''}}">
    <view class="detail-big block tone-sky pinyin-stage" bindtap="play" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">
      <image class="pinyin-vowel-image" src="{{item.image}}" mode="aspectFit" />
      <view class="detail-big__sub">{{item.phonetic}}</view>
      <play-button size="lg" passive="{{true}}" />
    </view>
    <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
    <view wx:if="{{nav.total > 1}}" class="trail-nav is-dock is-step" aria-label="切题">
      <view
        class="trail-nav__item {{nav.hasPrev ? '' : 'is-disabled'}}"
        bindtap="goPrev" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80"
        aria-label="上一题">
        <image class="trail-nav__arrow is-flip" src="/static/shared/arrow.png" mode="aspectFit" />
      </view>
      <view
        class="trail-nav__item {{nav.hasNext ? '' : 'is-disabled'}}"
        bindtap="goNext" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80"
        aria-label="下一题">
        <image class="trail-nav__arrow" src="/static/shared/arrow.png" mode="aspectFit" />
      </view>
    </view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="closePraise"
  />
</app-shell>
