<app-shell
  title="英语"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bar-text="{{barText}}"
  bind:continue="closeFeedback"
>
  <view wx:if="{{item}}" class="detail-stack">
    <detail-card
      tone="sky"
      image="{{item.image}}"
      image-class="detail-card__image--wide"
      sub="{{item.phonetic}}"
      playing="{{playingSrc === item.audio}}"
      bindtap="play"
    />
    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
  </view>
</app-shell>
