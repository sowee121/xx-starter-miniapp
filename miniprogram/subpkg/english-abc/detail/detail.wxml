<app-shell title="英语" stars="{{stars}}">
  <view wx:if="{{item}}" class="detail-stack">
    <view
      class="detail-big block tone-sky"
      bindtap="play"
      hover-class="is-pressed"
      hover-start-time="0"
      hover-stay-time="80"
    >
      <image class="pinyin-vowel-image" src="{{item.image}}" mode="aspectFit" lazy-load />
      <view class="detail-big__sub">{{item.phonetic}}</view>
      <play-button size="lg" passive="{{true}}" playing="{{playingSrc === item.audio}}" />
    </view>
    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
    <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="closePraise"
  />
</app-shell>
