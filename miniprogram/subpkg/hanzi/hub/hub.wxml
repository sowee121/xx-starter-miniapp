<app-shell title="识字" hint="认识汉字" sub-hint="看一看，听一听" stars="{{stars}}">
  <view class="duo">
    <view class="duo-card block tone-sky" data-lib="poem" bindtap="open">
      <image class="duo-card__image" src="{{poemImage}}" mode="aspectFit" />
      <text class="duo-card__title">古诗里的字</text>
      <text class="duo-card__sub">从古诗里认字</text>
    </view>
    <view class="duo-card block tone-peach" data-lib="life" bindtap="open">
      <image class="duo-card__image" src="{{lifeImage}}" mode="aspectFit" />
      <text class="duo-card__title">生活里的字</text>
      <text class="duo-card__sub">身边常用字</text>
    </view>
  </view>
</app-shell>
