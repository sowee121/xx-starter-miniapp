<app-shell title="识字" stars="{{stars}}">
  <view wx:if="{{item}}" class="detail-stack {{nav.total > 1 ? 'is-docked' : ''}}">
    <view class="detail-big block tone-peach" data-kind="char" bindtap="play">
      <view class="detail-emoji">{{item.emoji}}</view>
      <view class="detail-big__glyph">{{item.char}}</view>
      <view class="detail-big__sub">{{item.pinyin}} · {{item.strokes}}画</view>
      <play-button size="lg" data-kind="char" bind:tap="play" />
    </view>
    <view class="detail-pair">
      <view
        wx:for="{{item.words}}"
        wx:for-item="word"
        wx:for-index="widx"
        wx:key="*this"
        class="detail-pair__card block tone-cream"
        data-kind="word"
        data-index="{{widx}}"
        bindtap="play"
      >
        <view>{{word}}</view>
        <play-button compact="{{true}}" size="sm" data-kind="word" data-index="{{widx}}" bind:tap="play" />
      </view>
    </view>
    <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
    <view wx:if="{{nav.total > 1}}" class="trail-nav is-dock" aria-label="切题">
      <view
        class="trail-nav__item is-wide {{nav.hasPrev ? '' : 'is-disabled'}}"
        bindtap="goPrev"
      ><text class="trail-nav__glyph">上一个</text></view>
      <view
        class="trail-nav__item is-wide {{nav.hasNext ? '' : 'is-disabled'}}"
        bindtap="goNext"
      ><text class="trail-nav__glyph">下一个</text></view>
    </view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    bind:continue="closePraise"
  />
</app-shell>
