<app-shell
  title="识字"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bar-text="{{barText}}"
  bind:continue="closeFeedback"
>
  <view wx:if="{{item}}" class="detail-stack">
    <detail-card
      data-kind="char"
      tone="{{tone}}"
      emoji="{{item.emoji}}"
      glyph="{{item.char}}"
      sub="{{item.pinyin}} · {{item.strokes}} 画"
      playing="{{playingSrc === item.audio}}"
      bindtap="play"
    />
    <view class="detail-pair">
      <word-row
        wx:for="{{item.words}}"
        wx:for-item="word"
        wx:for-index="widx"
        wx:key="*this"
        half="{{true}}"
        text="{{word}}"
        active="{{playingSrc === item.wordAudios[widx]}}"
        playing="{{playingSrc === item.wordAudios[widx]}}"
        data-kind="word"
        data-index="{{widx}}"
        bindtap="play"
      />
    </view>
    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
  </view>
</app-shell>
