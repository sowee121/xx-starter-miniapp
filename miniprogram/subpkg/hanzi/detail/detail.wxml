<app-shell title="识字" stars="{{stars}}">
  <view wx:if="{{item}}" class="detail-stack">
    <view class="detail-big block tone-peach">
      <view class="detail-emoji">{{item.emoji}}</view>
      <text class="detail-big__glyph">{{item.char}}</text>
      <text class="detail-big__sub">{{item.pinyin}} · {{item.strokes}}画</text>
      <read-button size="lg" data-kind="char" bind:tap="play" />
    </view>
    <view class="detail-pair">
      <view
        wx:for="{{item.words}}"
        wx:for-item="word"
        wx:for-index="widx"
        wx:key="*this"
        class="detail-pair__card block tone-cream"
      >
        <text>{{word}}</text>
        <read-button size="sm" data-kind="word" data-index="{{widx}}" bind:tap="play" />
      </view>
    </view>
    <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    bind:continue="closePraise"
  />
</app-shell>
