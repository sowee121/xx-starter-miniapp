<app-shell title="识字" hint="生活里的字" sub-hint="看一看，听一听" stars="{{stars}}">
  <view class="section" wx:for="{{categories}}" wx:key="id">
    <view class="section-title">{{item.title}}</view>
    <view class="word-grid">
      <view
        wx:for="{{item.items}}"
        wx:for-item="hanzi"
        wx:key="char"
        class="word-card word-card--hanzi block tone-{{item.tone}}"
        data-char="{{hanzi.char}}"
        data-cat="{{item.id}}"
        bindtap="open"
        hover-class="is-pressed"
        hover-start-time="0"
        hover-stay-time="80"
      >
        <view class="word-card__emoji">{{hanzi.emoji}}</view>
        <view class="word-card__label">{{hanzi.char}}</view>
      </view>
    </view>
  </view>
</app-shell>
