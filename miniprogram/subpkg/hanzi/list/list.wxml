<app-shell title="识字" hint="生活常见字" sub-hint="听一听，认汉字" stars="{{stars}}">
  <view class="section" wx:for="{{categories}}" wx:key="id">
    <view class="section-title">{{item.title}}</view>
    <view class="word-grid">
      <word-card
        wx:for="{{item.items}}"
        wx:for-item="hanzi"
        wx:key="char"
        emoji="{{hanzi.emoji}}"
        label="{{hanzi.char}}"
        play="{{false}}"
        cls="word-card--hanzi tone-{{item.tone}}"
        data-char="{{hanzi.char}}"
        data-cat="{{item.id}}"
        bindtap="open"
      />
    </view>
  </view>
</app-shell>
