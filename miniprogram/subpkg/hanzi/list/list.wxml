<app-shell title="识字" hint="{{title}}" sub-hint="点一点就能听 · 笔画少到多" stars="{{stars}}">
  <view class="word-grid">
    <view
      wx:for="{{items}}"
      wx:key="char"
      class="word-card block tone-{{tone}}"
      data-char="{{item.char}}"
      bindtap="open"
    >
      <view class="word-card__char">{{item.char}}</view>
      <play-button size="sm" passive="{{true}}" />
    </view>
  </view>
</app-shell>
