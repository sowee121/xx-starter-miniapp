<app-shell
  title="英语"
  stars="{{stars}}"
  feedback="{{feedback}}"
  soft-note="{{softNote}}"
  bind:continue="closeFeedback"
>
  <view wx:if="{{item}}" class="detail-stack">
    <detail-card
      data-kind="word"
      tone="{{tone}}"
      image="{{item.image}}"
      title="{{item.word}}"
      sub="{{item.phonetic}}"
      meaning="{{item.meaning}}"
      playing="{{playingSrc === item.audio}}"
      bindtap="play"
    />
    <word-line
      text="{{item.sentence}}"
      active="{{playingSrc === item.sentenceAudio}}"
      playing="{{playingSrc === item.sentenceAudio}}"
      data-kind="sentence"
      bindtap="play"
    />
    <trail-nav
      show="{{nav.total > 1}}"
      has-prev="{{nav.hasPrev}}"
      has-next="{{nav.hasNext}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
  </view>
</app-shell>
