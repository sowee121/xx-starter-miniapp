.detail-stack {
  gap: var(--gap-grid);
}

.calendar-scene {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-card);
  padding: var(--pad-card-lg);
  text-align: center;
  box-sizing: border-box;
  overflow: visible;
}

.calendar-scene big-button {
  align-self: stretch;
  width: 100%;
}

.calendar-scene__sky {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 240rpx;
}

.calendar-scene__sky-image {
  width: 240rpx;
  height: 242rpx; /* 太阳 445×448 */
}

.calendar-scene--night .calendar-scene__sky-image {
  height: 176rpx; /* 月亮 448×328 */
}

.calendar-scene__today {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-text);
}

.calendar-scene__date {
  font-size: var(--font-date);
  font-weight: 700;
  color: var(--ink);
}

.calendar-scene__week {
  font-size: var(--font-hint);
  color: var(--muted);
}

.calendar-scene--night {
  color: var(--night-ink);
}

.calendar-scene--night .calendar-scene__date {
  color: var(--night-ink);
  text-shadow: 0 3rpx 8rpx rgba(12, 18, 46, 0.28);
}

.calendar-scene--night .calendar-scene__week {
  color: var(--night-muted);
}
