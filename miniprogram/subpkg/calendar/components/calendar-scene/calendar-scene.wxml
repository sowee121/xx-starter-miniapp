<view
  class="calendar-scene motion-tap block {{isNight ? 'tone-night calendar-scene--night' : 'tone-butter'}}"
>
  <view class="calendar-scene__sky">
    <image class="calendar-scene__sky-image" src="{{skyIcon}}" mode="aspectFit" />
  </view>
  <view class="calendar-scene__today">
    <view class="calendar-scene__date">{{dateText}}</view>
    <view class="calendar-scene__week">{{weekday}}</view>
  </view>
  <block-button
    text="{{checkedIn ? '今天已打卡' : '打卡'}}"
    disabled="{{checkedIn}}"
    bind:tap="onCheckinTap"
  />
</view>
