.heat {
  display: flex;
  flex-direction: column;
  gap: var(--gap-row);
  padding: var(--pad-card-lg);
  box-sizing: border-box;
}

.heat__title {
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.2;
  text-align: center;
  color: var(--ink);
}

.heat__week,
.heat__grid,
.heat__legend {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--gap-row);
}

.heat__week,
.heat__grid {
  width: 100%;
  gap: var(--gap-row);
}

.heat__legend {
  gap: var(--gap-text);
}

.heat__wd,
.heat__grid .heat__cell {
  flex: 0 0 calc((100% - var(--gap-row) * 6) / 7);
  width: calc((100% - var(--gap-row) * 6) / 7);
  box-sizing: border-box;
}

.heat__wd {
  font-size: var(--font-hint);
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  color: var(--muted);
}

.heat__grid .heat__cell {
  aspect-ratio: 1;
  height: auto;
  border-radius: var(--radius-cell);
}

.heat__cell.is-pad {
  background: transparent;
}

.heat__cell.is-lv0 {
  background: var(--heat-lv0);
}

.heat__cell.is-lv1 {
  background: var(--heat-lv1);
}

.heat__cell.is-lv2 {
  background: var(--heat-lv2);
}

.heat__cell.is-lv3 {
  background: var(--heat-lv3);
}

.heat__cell.is-lv4 {
  background: var(--heat-lv4);
}

.heat__cell.is-today {
  box-shadow: 0 0 0 6rpx var(--ring-ok);
}

.heat__legend {
  justify-content: flex-end;
}

.heat__legend .heat__cell {
  flex: 0 0 var(--font-nav);
  width: var(--font-nav);
  min-width: var(--font-nav);
  height: var(--font-nav);
  border-radius: calc(var(--radius-cell) / 2);
}

.heat__legend-label {
  font-size: var(--font-nav);
  font-weight: 700;
  color: var(--muted);
}

.heat.tone-night .heat__title {
  color: var(--night-ink);
}

.heat.tone-night .heat__wd,
.heat.tone-night .heat__legend-label {
  color: var(--night-muted);
}

.heat.tone-night .heat__cell.is-lv0 {
  background: var(--heat-lv0-night);
}
