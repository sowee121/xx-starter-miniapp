<app-shell title="日历" hint="" stars="{{stars}}" background="{{background}}" night="{{isNight}}">
  <view class="detail-stack">
    <view
      class="calendar-scene block {{isNight ? 'tone-night calendar-scene--night' : 'tone-butter'}}"
    >
      <view class="calendar-scene__sky">
        <image class="calendar-scene__sky-image" src="{{skyIcon}}" mode="aspectFit" />
      </view>
      <view class="calendar-scene__today">
        <view class="calendar-scene__date">{{dateText}}</view>
        <view class="calendar-scene__week">{{weekday}}</view>
      </view>
      <big-button
        text="{{checkedIn ? '今天已打卡' : '打卡'}}"
        disabled="{{checkedIn}}"
        bind:tap="onCheckin"
      />
    </view>
    <activity-month
      title="{{heat.title}}"
      weekdays="{{heat.weekdays}}"
      cells="{{heat.cells}}"
      night="{{isNight}}"
    />
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="closePraise"
  />
</app-shell>
