<app-shell
  title="日历"
  hint=""
  stars="{{stars}}"
  background="{{background}}"
  night="{{isNight}}"
  feedback="{{feedback}}"
  bind:continue="closeFeedback"
>
  <view class="detail-stack">
    <calendar-scene
      skyIcon="{{skyIcon}}"
      isNight="{{isNight}}"
      dateText="{{dateText}}"
      weekday="{{weekday}}"
      checkedIn="{{checkedIn}}"
      bind:checkin="onCheckin"
    />
    <activity-month
      title="{{heat.title}}"
      weekdays="{{heat.weekdays}}"
      cells="{{heat.cells}}"
      night="{{isNight}}"
    />
  </view>
</app-shell>
