/* H5 pages.css · 家长区 1px = 1rpx */
/* 卡面与卡头两张卡共用，留在页面由组件共享（组件统一 apply-shared）；
   各自独有的 .volume-* / .clear-* 已随组件走 */
.setting-block {
  display: flex;
  flex-direction: column;
  gap: var(--pad-card);
  padding: var(--pad-card);
}

.setting-head {
  display: flex;
  align-items: center;
  gap: var(--pad-card);
}
.setting-head__title {
  font-size: var(--font-title);
}

.setting-head__hint {
  line-height: 1.45;
}

.parent-about {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--gap-row);
  color: var(--muted);
  font-size: var(--font-nav);
}

.parent-about::before,
.parent-about::after {
  content: '';
  width: 50rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: rgba(110, 143, 118, 0.2);
}
