<app-shell title="家长区" hint="家长设置" sub-hint="陪伴宝贝，轻松调整" stars="{{stars}}">
  <view class="parent-stack">
    <volume-card title="音量大小" hint="调节点读和答题音量大小" />

    <clear-card
      wx:for="{{actions}}"
      wx:key="key"
      data-key="{{item.key}}"
      icon="{{item.icon}}"
      icon-class="{{item.iconClass}}"
      title="{{item.title}}"
      hint="{{item.hint}}"
      tone="{{item.tone}}"
      groove="{{item.groove}}"
      verb="{{item.verb}}"
      result="{{item.result}}"
      bind:confirm="onClear"
    />

    <view class="parent-about">嘻嘻启蒙乐园 · 版本 1.0</view>
  </view>
</app-shell>
