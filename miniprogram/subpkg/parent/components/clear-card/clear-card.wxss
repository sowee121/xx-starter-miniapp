/* H5 pages.css · 家长区清除卡 1px = 1rpx；卡面 / 卡头共用类仍在 subpkg/parent/index.wxss */

.clear-block {
  padding: var(--pad-card);
  overflow: visible;
}

.clear-icon-slot {
  width: var(--size-slot);
  height: var(--size-slot);
  flex-shrink: 0;
  transform: scale(1.3);
  transform-origin: 50% 50%;
}

.clear-icon {
  display: block;
  width: var(--size-slot);
  height: var(--size-slot);
  flex: 0 0 var(--size-slot);
}

.clear-groove {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--size-slot);
  overflow: hidden;
  border-radius: var(--radius-pill);
  box-sizing: border-box;
  color: #fff;
  background: var(--btn-rose);
  box-shadow: var(--shadow-btn-rose);
}

.clear-groove.is-matcha {
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.clear-groove.is-holding {
  transform: scale(0.98);
}

.clear-groove__bar {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.24);
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
}

.clear-groove__bar.is-filling {
  animation: clear-groove-fill 2.8s linear forwards;
}

@keyframes clear-groove-fill {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

.clear-groove.is-matcha .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-groove.is-sky {
  background: var(--btn-sky);
  box-shadow: var(--shadow-btn-sky);
}

.clear-groove.is-sky .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-groove.is-apricot {
  background: var(--btn-apricot);
  box-shadow: var(--shadow-btn-apricot);
}

.clear-groove.is-apricot .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-label {
  position: relative;
  z-index: 1;
  font-size: var(--font-hint);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
}
