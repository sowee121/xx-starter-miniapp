/* H5 pages.css · 家长区音量卡 1px = 1rpx；卡面 / 卡头共用类仍在 subpkg/parent/index.wxss */

.volume-options {
  position: relative;
  display: flex;
  align-items: stretch;
  height: var(--size-slot);
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: var(--radius-pill);
  background: rgba(116, 151, 126, 0.12);
  box-shadow: inset 0 4rpx 10rpx rgba(91, 123, 93, 0.1);
}

.volume-thumb {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  width: calc((100% - 16rpx) / 3);
  border-radius: var(--radius-pill);
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
  transition: left 120ms ease-out;
}

.volume-option {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: var(--radius-pill);
  background: transparent;
  color: var(--ink);
  font-size: var(--font-hint);
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.volume-option.is-active {
  color: #fff;
}
