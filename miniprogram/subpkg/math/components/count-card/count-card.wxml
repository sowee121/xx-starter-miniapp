<view class="quiz-head motion-tap block tone-rose">
  <view class="count-stage count-stage--{{count}}">
    <image
      wx:for="{{items}}"
      wx:key="index"
      class="count-item"
      src="{{item}}"
      mode="aspectFit"
      lazy-load
    />
  </view>
  <view class="quiz-head__title">{{prompt}}</view>
</view>
