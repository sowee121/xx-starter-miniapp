<app-shell title="数一数" stars="{{stars}}">
  <view wx:if="{{question}}" class="detail-stack">
    <view class="quiz-head block tone-cream">
      <view class="count-stage count-stage--{{count}} count-stage--cols-{{cols}}">
        <image
          wx:for="{{items}}"
          wx:key="index"
          class="count-item"
          src="{{item}}"
          mode="aspectFit"
          lazy-load
        />
      </view>
      <view class="quiz-head__title">{{question.prompt}}</view>
    </view>
    <view class="options">
      <view
        wx:for="{{question.choices}}"
        wx:key="*this"
        class="option block {{index === 0 ? 'tone-sky' : (index === 1 ? 'tone-butter' : 'tone-peach')}} {{item === pickedValue ? 'is-picked' : ''}} {{pickedCorrect && item === pickedValue ? 'is-correct' : ''}}"
        data-value="{{item}}"
        bindtap="choose"
      >{{item}}</view>
    </view>
    <view wx:if="{{softNote}}" class="soft-note block tone-butter">{{softNote}}</view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    bind:continue="next"
  />
</app-shell>
