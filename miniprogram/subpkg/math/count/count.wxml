<app-shell title="数一数" stars="{{stars}}">
  <view wx:if="{{question}}" class="detail-stack is-docked">
    <view class="quiz-head block tone-butter">
      <view class="count-stage count-stage--{{count}} count-stage--cols-{{cols}}">
        <image
          wx:for="{{items}}"
          wx:key="index"
          class="count-item"
          src="{{item}}"
          mode="aspectFit"
          lazy-load
        />
      </view>
      <view class="quiz-head__title">{{question.prompt}}</view>
    </view>
    <view class="options">
      <view
        wx:for="{{question.choices}}"
        wx:key="*this"
        class="option block {{index === 0 ? 'tone-sky' : (index === 1 ? 'tone-butter' : 'tone-peach')}} {{item === pickedValue ? 'is-picked' : ''}} {{pickedCorrect && item === pickedValue ? 'is-correct' : ''}}"
        data-value="{{item}}"
        bindtap="choose" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">{{item}}</view>
    </view>
    <view wx:if="{{softNote}}" class="soft-note block {{softNoteTone}}">{{softNote}}</view>
    <view class="trail-nav is-dock is-step" aria-label="切题">
      <view
        class="trail-nav__item {{nav.hasPrev ? '' : 'is-disabled'}}"
        bindtap="goPrev" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80"
        aria-label="上一题">
        <image class="trail-nav__arrow is-flip" src="/static/shared/arrow.png" mode="aspectFit" />
      </view>
      <view class="trail-nav__item" bindtap="goNext" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80" aria-label="下一题">
        <image class="trail-nav__arrow" src="/static/shared/arrow.png" mode="aspectFit" />
      </view>
    </view>
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="next"
  />
</app-shell>
