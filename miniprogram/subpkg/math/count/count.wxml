<quiz-frame
  type="count"
  title="数一数"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bar-text="{{barText}}"
  bar-tone="{{barTone}}"
  wrong-shake="{{wrongShake}}"
  question="{{question}}"
  choices="{{choices}}"
  picked-value="{{pickedValue}}"
  picked-correct="{{pickedCorrect}}"
  option-tones="{{['sky', 'butter', 'peach']}}"
  items="{{items}}"
  count="{{count}}"
  has-prev="{{nav.hasPrev}}"
  bind:choose="choose"
  bind:prev="goPrev"
  bind:next="goNext"
  bind:continue="next"
/>
