<app-shell title="算一算" stars="{{stars}}">
  <view wx:if="{{question}}" class="detail-stack">
    <view class="quiz-head block tone-sky">
      <image class="quiz-head__image" src="{{calcImage}}" mode="aspectFit" />
      <view class="quiz-head__equation">{{question.a}} {{question.op}} {{question.b}} = ?</view>
    </view>
    <view class="options">
      <view
        wx:for="{{question.choices}}"
        wx:key="*this"
        class="option block {{index === 0 ? 'tone-peach' : (index === 1 ? 'tone-butter' : 'tone-lilac')}} {{item === pickedValue ? 'is-picked' : ''}} {{pickedCorrect && item === pickedValue ? 'is-correct' : ''}}"
        data-value="{{item}}"
        bindtap="choose" hover-class="is-pressed" hover-start-time="0" hover-stay-time="80">{{item}}</view>
    </view>
    <view wx:if="{{softNote}}" class="soft-note block {{softNoteTone}}">{{softNote}}</view>
    <trail-nav
      has-prev="{{nav.hasPrev}}"
      has-next="{{true}}"
      bind:prev="goPrev"
      bind:next="goNext"
    />
  </view>
  <praise-sun
    show="{{feedback.show}}"
    closing="{{feedback.closing}}"
    variant="{{feedback.variant}}"
    title="{{feedback.title}}"
    desc="{{feedback.desc}}"
    action="{{feedback.action}}"
    bind:continue="next"
  />
</app-shell>
