<quiz-frame
  type="calc"
  title="算一算"
  stars="{{stars}}"
  feedback="{{feedback}}"
  bar-text="{{barText}}"
  bar-tone="{{barTone}}"
  wrong-shake="{{wrongShake}}"
  question="{{question}}"
  choices="{{choices}}"
  picked-value="{{pickedValue}}"
  picked-correct="{{pickedCorrect}}"
  option-tones="{{['mint', 'lilac', 'rose']}}"
  calc-image="{{calcImage}}"
  has-prev="{{nav.hasPrev}}"
  bind:choose="choose"
  bind:prev="goPrev"
  bind:next="goNext"
  bind:continue="next"
/>
