.feature-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 172rpx;
  padding: 0 var(--pad-card) 0 0;
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.feature-card__mascot {
  width: var(--size-mascot);
  height: var(--size-mascot);
  flex-shrink: 0;
}

.feature-card__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--gap-text);
  flex: 1;
  min-width: 0;
}

.feature-card__title {
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.feature-card__sub {
  white-space: nowrap;
  font-size: var(--font-hint);
  color: var(--muted);
  line-height: 1.3;
}

.feature-card__sockets {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-text);
}

.feature-card__socket {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(154, 182, 138, 0.22);
  box-shadow: var(--shadow-socket);
}

.feature-card__socket.is-on {
  background: rgba(255, 255, 255, 0.55);
  box-shadow: var(--shadow-socket-on);
}

.feature-card__socket-star {
  width: 56rpx;
  height: 56rpx;
}

.feature-card__deco {
  width: 64rpx;
  height: 64rpx; /* 勾勾 / 星星 均为正方形 */
  flex-shrink: 0;
  pointer-events: none;
}
