.hello-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--pad-card);
  width: 100%;
  height: 144rpx;
  padding: 16rpx var(--pad-card);
  /* 头像放大 1.2 会越出卡片，此处不能裁 */
  overflow: visible;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.hello-card__body {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--gap-text);
  flex: 1;
  min-width: 0;
}

.hello-card__avatar-slot {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
  transform: scale(1.2);
  transform-origin: 50% 50%;
}

.hello-card__avatar {
  display: block;
  width: 112rpx;
  height: 112rpx;
}

.hello-card__hello {
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.hello-card__sub {
  font-size: var(--font-hint);
  color: var(--muted);
  line-height: 1.3;
}

.hello-card__deco {
  width: 64rpx;
  height: 101rpx; /* 雏菊 122×192 */
  flex-shrink: 0;
  pointer-events: none;
}
