.home-page {
  position: relative;
  min-height: 100%;
  width: 100%;
  overflow: visible;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
  box-sizing: border-box;
}

.home-page .scene__meadow {
  width: 100%;
  height: var(--size-meadow);
}

.home-page__shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
  min-height: 100%;
  box-sizing: border-box;
  padding-left: var(--pad-page-x);
  padding-right: var(--pad-page-x);
  padding-bottom: env(safe-area-inset-bottom);
}

.home-welcome {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-card);
  height: 144rpx;
  padding: 16rpx var(--pad-card);
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-welcome--pressed {
  transform: scale(0.985);
}

.home-welcome__avatar {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.home-welcome__hello {
  font-size: var(--font-title);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.home-welcome__deco {
  width: 64rpx;
  height: auto;
  flex-shrink: 0;
  pointer-events: none;
}

.home-page__block {
  display: block;
  flex-shrink: 0;
}

.home-modules {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: var(--gap-grid);
}

/* 两列宽度定在参与排列的节点上：组件宿主节点无宽度，百分比无法在组件内部生效 */
.home-modules__cell {
  width: var(--col-2);
  flex-shrink: 0;
}
