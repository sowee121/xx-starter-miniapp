.home-page {
  position: relative;
  min-height: 100%;
  width: 100%;
  overflow: visible;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
  box-sizing: border-box;
}

.home-page .scene__meadow {
  width: 100%;
  height: var(--size-meadow);
}

.home-page__shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
  min-height: 100%;
  box-sizing: border-box;
  padding-left: var(--pad-page);
  padding-right: var(--pad-page);
  padding-bottom: var(--pad-page);
  padding-bottom: calc(var(--pad-page) + env(safe-area-inset-bottom, 0px));
}

.home-page__block {
  display: block;
  flex-shrink: 0;
}

.home-modules {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: var(--gap-grid);
}

/* 两列宽度定在参与排列的节点上：组件宿主节点无宽度，百分比无法在组件内部生效 */
.home-modules__cell {
  width: var(--col-2);
  flex-shrink: 0;
}
