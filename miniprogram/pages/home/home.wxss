.home-page {
  position: relative;
  min-height: 100%;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
  box-sizing: border-box;
}

.home-page__bg {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.18) 12%,
    rgba(0, 0, 0, 0.5) 22%,
    rgba(0, 0, 0, 0.82) 30%,
    #000 40%,
    #000 100%
  );
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.18) 12%,
    rgba(0, 0, 0, 0.5) 22%,
    rgba(0, 0, 0, 0.82) 30%,
    #000 40%,
    #000 100%
  );
}

.home-page__shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: var(--block-gap);
  min-height: 100%;
  box-sizing: border-box;
  padding-left: var(--page-pad-x);
  padding-right: var(--page-pad-x);
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}

.home-welcome {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-card);
  height: 156rpx;
  padding: var(--pad-card);
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-welcome--pressed {
  transform: scale(0.985);
}

.home-welcome__avatar {
  width: 112rpx;
  height: 112rpx;
  flex-shrink: 0;
}

.home-welcome__hello {
  font-size: var(--font-hello);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.home-welcome__deco {
  width: 56rpx;
  height: 88rpx;
  flex-shrink: 0;
  pointer-events: none;
}

.home-page__block {
  display: block;
  flex-shrink: 0;
}

.home-modules {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: var(--block-gap);
  flex: 1;
  min-height: 786rpx;
}

/* 两列宽度定在参与排列的节点上：组件宿主节点无宽度，百分比无法在组件内部生效 */
.home-modules__cell {
  width: var(--col-2);
  flex-shrink: 0;
}
