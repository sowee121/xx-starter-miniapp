.home-page {
  position: relative;
  min-height: 100%;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
  box-sizing: border-box;
}

.home-page__bg {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  z-index: 0;
  pointer-events: none;
  -webkit-mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.18) 12%,
    rgba(0, 0, 0, 0.5) 22%,
    rgba(0, 0, 0, 0.82) 30%,
    #000 40%,
    #000 100%
  );
  mask-image: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0) 0%,
    rgba(0, 0, 0, 0.18) 12%,
    rgba(0, 0, 0, 0.5) 22%,
    rgba(0, 0, 0, 0.82) 30%,
    #000 40%,
    #000 100%
  );
}

.home-page__shell {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  min-height: 100%;
  box-sizing: border-box;
  padding-left: 30rpx;
  padding-right: 30rpx;
  padding-bottom: 80rpx;
}

.home-welcome {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 22rpx;
  height: 132rpx;
  padding: 0 30rpx;
  padding-right: 90rpx;
  overflow: hidden;
  border-radius: 48rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-welcome__avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.home-welcome__copy {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.home-welcome__hello {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 6rpx;
  color: #35553f;
}

.home-welcome__sub {
  font-size: 26rpx;
  line-height: 1.3;
  color: #6e8f76;
}

.home-welcome__deco {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 48rpx;
  height: 75rpx;
  transform: translateY(-50%);
  pointer-events: none;
}

.home-page__block {
  display: block;
  flex-shrink: 0;
}

.home-modules {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  gap: 30rpx;
  flex: 1;
  min-height: 786rpx;
}

/* 两列宽度定在参与排列的节点上：组件宿主节点无宽度，百分比无法在组件内部生效 */
.home-modules__cell {
  width: calc((100% - 30rpx) / 2);
  flex-shrink: 0;
}
