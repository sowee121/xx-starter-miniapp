/* H5 pages.css · 家长区 1px = 1rpx */
.setting-block {
  display: flex;
  flex-direction: column;
  gap: var(--pad-card);
  padding: var(--pad-card);
}

.setting-head {
  display: flex;
  align-items: center;
  gap: var(--pad-card);
}
.setting-head__title {
  font-size: var(--font-title);
}

.setting-head__hint {
  line-height: 1.45;
}

.volume-options {
  position: relative;
  display: flex;
  align-items: stretch;
  height: var(--size-slot);
  box-sizing: border-box;
  padding: 8rpx;
  border-radius: var(--radius-pill);
  background: rgba(116, 151, 126, 0.12);
  box-shadow: inset 0 4rpx 10rpx rgba(91, 123, 93, 0.1);
}

.volume-thumb {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  width: calc((100% - 16rpx) / 3);
  border-radius: var(--radius-pill);
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
  transition: left 120ms ease-out;
}

.volume-option {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  border-radius: var(--radius-pill);
  background: transparent;
  color: var(--ink);
  font-size: var(--font-hint);
  font-weight: 700;
  position: relative;
  z-index: 1;
  transition: var(--motion-tap);
}

.volume-option.is-active {
  color: #fff;
}

.clear-block {
  padding: var(--pad-card);
  overflow: visible;
}

.clear-icon-slot {
  width: var(--size-slot);
  height: var(--size-slot);
  flex-shrink: 0;
  transform: scale(1.3);
  transform-origin: 50% 50%;
}

.clear-icon {
  display: block;
  width: var(--size-slot);
  height: var(--size-slot);
  flex: 0 0 var(--size-slot);
}

.clear-groove {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: var(--size-slot);
  overflow: hidden;
  border-radius: var(--radius-pill);
  box-sizing: border-box;
  color: #fff;
  background: linear-gradient(180deg, #e0a4b4, #c88698);
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.28),
    inset 0 -6rpx 12rpx rgba(160, 90, 110, 0.28),
    0 8rpx 16rpx rgba(180, 120, 140, 0.18);
  transition: var(--motion-tap);
}

.clear-groove.is-matcha {
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.clear-groove.is-peach {
  background: linear-gradient(180deg, #deb0a0, #c89888);
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.28),
    inset 0 -6rpx 12rpx rgba(140, 90, 78, 0.28),
    0 8rpx 16rpx rgba(170, 120, 100, 0.18);
}

.clear-groove.is-holding {
  transform: scale(0.98);
}

.clear-groove__bar {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  border-radius: 0;
  background: rgba(255, 255, 255, 0.24);
  transform: scaleX(0);
  transform-origin: left center;
  will-change: transform;
}

.clear-groove__bar.is-filling {
  animation: clear-groove-fill 2.8s linear forwards;
}

@keyframes clear-groove-fill {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

.clear-groove.is-matcha .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-groove.is-peach .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-label {
  position: relative;
  z-index: 1;
  font-size: var(--font-hint);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
}

.parent-about {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--gap-row);
  color: var(--muted);
  font-size: var(--font-nav);
}

.parent-about::before,
.parent-about::after {
  content: "";
  width: 50rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: rgba(110, 143, 118, 0.2);
}
