/* H5 pages.css · 家长区 1px = 1rpx */
.setting-block {
  display: flex;
  flex-direction: column;
  gap: var(--gap-block);
  padding: var(--pad-card-lg);
}

.setting-head {
  display: flex;
  align-items: center;
  gap: var(--gap-card);
}

.setting-head__title,
.volume-option,
.clear-label {
  font-family: "Yuanti SC", "Yuanti TC", "PingFang SC", sans-serif;
}

.volume-option,
.clear-label {
  letter-spacing: var(--letter-btn);
}

.setting-head__title {
  font-size: var(--font-title);
}

.setting-head__hint {
  line-height: 1.45;
}

.sound-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  border-radius: 56rpx;
  background: var(--btn-play);
  box-shadow: var(--shadow-play);
}

.sound-button__icon {
  width: 54rpx;
  height: 54rpx;
  margin-left: 5rpx;
}

.volume-options {
  position: relative;
  display: flex;
  padding: 10rpx;
  border-radius: 999rpx;
  background: rgba(116, 151, 126, 0.12);
  box-shadow: inset 0 4rpx 10rpx rgba(91, 123, 93, 0.1);
}

.volume-thumb {
  position: absolute;
  top: 10rpx;
  bottom: 10rpx;
  width: calc((100% - 20rpx) / 3);
  border-radius: 999rpx;
  background: var(--btn-green);
  box-shadow: var(--shadow-chip);
  transition: left 120ms ease-out;
}

.volume-option {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  flex: 1;
  border-radius: 999rpx;
  background: transparent;
  color: var(--ink);
  font-size: var(--font-hint);
  font-weight: 700;
  position: relative;
  z-index: 1;
}

.volume-option.is-active {
  color: #fff;
}

.clear-block {
  padding: var(--pad-card-lg);
}

.clear-icon {
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
}

.clear-groove {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  overflow: hidden;
  border-radius: 999rpx;
  box-sizing: border-box;
  color: #fff;
  background: linear-gradient(180deg, #e0a4b4, #c88698);
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.4),
    inset 0 -6rpx 12rpx rgba(160, 90, 110, 0.28),
    0 8rpx 16rpx rgba(180, 120, 140, 0.18);
  transition: transform 80ms ease-out;
}

.clear-groove.is-matcha {
  background: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.clear-groove.is-peach {
  background: linear-gradient(180deg, #deb0a0, #c89888);
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.4),
    inset 0 -6rpx 12rpx rgba(140, 90, 78, 0.28),
    0 8rpx 16rpx rgba(170, 120, 100, 0.18);
}

.clear-groove.is-holding {
  transform: scale(0.98);
}

.clear-groove__bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0;
  border-radius: inherit;
  background: rgba(255, 255, 255, 0.24);
  will-change: width;
  transition: width 160ms ease-out;
}

.clear-groove__bar.is-filling {
  width: 100%;
  transition: none;
  animation: clear-groove-fill 3s linear forwards;
}

@keyframes clear-groove-fill {
  from {
    width: 0;
  }

  to {
    width: 100%;
  }
}

.clear-groove.is-matcha .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-groove.is-peach .clear-groove__bar {
  background: rgba(255, 255, 255, 0.22);
}

.clear-label {
  position: relative;
  z-index: 1;
  font-size: var(--font-hint);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
}

.parent-about {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--gap-row);
  color: var(--muted);
  font-size: var(--font-nav);
}

.parent-about::before,
.parent-about::after {
  content: "";
  width: 50rpx;
  height: 2rpx;
  border-radius: 1rpx;
  background: rgba(110, 143, 118, 0.2);
}
