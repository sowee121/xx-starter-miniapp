.coming {
  min-height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--pad-card) 0 var(--gap-text);
  box-sizing: border-box;
}

.coming__mascot {
  width: 400rpx;
  height: 380rpx;
}

.coming__headline {
  margin-top: 12rpx;
  font-size: var(--font-date);
  font-weight: 700;
  color: var(--ink);
  text-align: center;
}

.coming__sub {
  margin-top: 16rpx;
  font-size: var(--font-nav);
  font-weight: 600;
  color: var(--muted);
  text-align: center;
}

.coming__btn {
  width: 100%;
  margin-top: auto;
}
