/* H5 blocks.css · 积木卡与基础控件（仅保留主包相关 + 公共样式） */

/* 纵向积木间距统一由容器 gap 提供，积木自身不带 margin */
.block {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.block,
.play-btn-hit,
.play-btn,
.chip,
.block-btn,
.custom-header__home,
.feedback-layer__continue,
.volume-option,
.home-welcome-card,
.home-feature-card,
.home-feature-card__socket,
.home-module-card,
.hub-entry-card,
.word-row,
.task-row,
.task-row__tick,
.clear-groove,
.option,
.trail-nav__item {
  transition: var(--motion-tap);
}

/* 仅 hover-class / 可点控件按下；静态积木不要 .block:active */
.is-pressed,
.play-btn-hit:active .play-btn,
.play-btn:active,
.custom-header__home:active,
.feedback-layer__continue:active,
.volume-option:active,
.trail-nav__item:active {
  transform: scale(0.985);
}

.chip.is-owned:active,
.chip.is-owned.is-pressed,
.chip.is-short:active,
.chip.is-short.is-pressed,
.block-btn.is-disabled:active,
.block-btn.is-disabled.is-pressed,
.trail-nav__item.is-disabled:active,
.trail-nav__item.is-disabled.is-pressed {
  transform: none;
}

/* 禁用态：统一透明 + 不可点，所有组件的 is-disabled 共用 */
.is-disabled {
  opacity: var(--opacity-disabled);
  pointer-events: none;
}

/* 对角 inset = 鹅卵石鼓边（上左高光 / 下右压暗），外阴影托起厚度 */
.tone-cream {
  background: var(--tone-cream);
  box-shadow: var(--shadow-tone-cream);
}

