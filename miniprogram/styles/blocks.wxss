.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 0;
  font-weight: 700;
  color: #ffffff;
  border-radius: var(--radius-pill);
  background-color: var(--btn-green-solid);
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
  box-sizing: border-box;
  width: var(--size-chip-wide);
  height: var(--size-chip-lg);
  font-size: var(--font-hint);
}

.chip.is-compact {
  min-width: var(--size-chip-min);
  width: auto;
  height: var(--size-header);
  font-size: var(--font-hint);
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.chip.is-owned {
  font-weight: 800;
  background: rgba(255, 253, 247, 0.88);
  color: var(--muted);
  box-shadow: var(--shadow-clay);
}

.chip.is-short {
  opacity: var(--opacity-disabled);
}

.chip:active {
  transform: scale(0.97);
}

.chip.is-owned,
.chip.is-short {
  pointer-events: none;
}

.chip.is-owned:active,
.chip.is-short:active {
  transform: none;
}

/* 圆钮视觉在 components/play-button；此处只保留按下过渡 */

/* 列表分组：标题与同类卡片用网格间距 30 */
.section-title {
  margin: 0;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--muted);
}

.section {
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
}


