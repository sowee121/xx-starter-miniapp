/* H5 pages.css · 学习列表 / 详情 / 答题公共结构 */

.media-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-row);
  min-height: var(--media-row-height);
  padding: var(--pad-card);
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.media-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-card);
  flex: 1;
  min-width: 0;
}

.media-main__thumb {
  width: var(--media-thumb-height);
  height: var(--media-thumb-height);
  flex-shrink: 0;
  overflow: hidden;
  border-radius: var(--radius-thumb);
}

.media-main__thumb--wide {
  width: calc(var(--media-thumb-height) * 4 / 3);
}

.media-main__image {
  width: 100%;
  height: 100%;
  display: block;
}

.media-main__title {
  font-size: var(--font-card);
}

.media-main__sub {
  white-space: nowrap;
}

.media-play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.media-row .media-play,
.poem-line .media-play,
.poem-line .play-btn-hit,
.detail-pair__card .play-btn-hit,
.media-row .play-btn-hit {
  min-width: 0;
  min-height: 0;
  justify-content: flex-end;
}

.duo {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--block-gap);
}

.duo-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--col-2);
  min-height: 352rpx;
  gap: var(--gap-text);
  padding: var(--pad-card-sm);
  text-align: center;
  border-radius: var(--radius-tile);
  box-sizing: border-box;
}

.duo-card__image {
  width: 188rpx;
  height: 188rpx;
}

.duo-card__title {
  font-size: var(--font-card);
}

/* 每行 3 卡：横向范围由 app-shell 控制，网格内部只用 gap 分隔 */
.word-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 100%;
  gap: var(--block-gap);
}

.word-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-inset);
  width: var(--col-3);
  height: 248rpx;
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
  border-radius: var(--radius-tile);
  box-sizing: border-box;
}

.word-card__char {
  font-size: var(--font-display);
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.word-card__image {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
}

.word-card__label {
  font-size: var(--font-hint);
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

.word-card--english {
  height: 210rpx;
}

.word-card--english .word-card__image {
  width: 88rpx;
  height: 88rpx;
}

.word-card--hanzi {
  height: 210rpx;
}

.word-card__emoji {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
}

.word-card--hanzi .word-card__label {
  font-size: var(--font-title);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-row);
  padding: var(--pad-card);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.hero__image {
  display: block;
  align-self: stretch;
  width: 100%;
  height: auto;
  aspect-ratio: 4 / 3;
  border-radius: var(--radius-thumb);
}

.hero__title {
  font-size: var(--font-hero);
}

.poem-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-row);
  padding: var(--pad-card);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.poem-line.is-active {
  /* 覆盖 tone-cream，对齐 H5 .poem-line.active */
  background: linear-gradient(180deg, #fff8ee, #f9edc6) !important;
}

.poem-line__text {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  font-size: var(--font-line);
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
}

.detail-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-block);
  padding: var(--pad-card-xl);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.detail-big__image {
  width: 320rpx;
  height: 320rpx;
}

.detail-big__vowel {
  width: 360rpx;
  height: 360rpx;
}

.pinyin-vowel-image {
  width: 360rpx;
  height: 360rpx;
}

/* 跟读伙伴坞（对齐 H5 pages.css） */
.buddy-dock {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 176rpx;
  padding: var(--pad-card);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.buddy-dock__mascot {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
}

.buddy-dock__bubble {
  --buddy-bubble-fill: #dce6cc;
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--pad-card);
  overflow: visible;
  border-radius: var(--radius-pill);
  background: var(--buddy-bubble-fill);
  filter: drop-shadow(0 6rpx 12rpx rgba(96, 122, 96, 0.14));
  font-size: var(--font-note);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  text-align: center;
  box-sizing: border-box;
}

.buddy-dock__bubble-tail {
  position: absolute;
  left: 12rpx;
  top: 50%;
  width: 46rpx;
  height: 42rpx;
  background: var(--buddy-bubble-fill);
  clip-path: polygon(100% 0, 100% 100%, 0 50%);
  transform: translate(-62%, -50%);
  z-index: 0;
}

.buddy-dock__bubble-text {
  position: relative;
  z-index: 1;
}

.detail-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  font-size: 100rpx;
  line-height: 1;
}

.detail-big__glyph {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.detail-big__title {
  font-size: var(--font-inner);
}

.detail-pair {
  display: flex;
  flex-direction: row;
  gap: 38rpx;
}

.detail-pair__card {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  width: calc((100% - 38rpx) / 2);
  min-height: 120rpx;
  padding: var(--pad-card);
  font-size: var(--font-note);
  font-weight: 700;
  color: var(--ink);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.quiz-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-block);
  padding: var(--pad-card-xl);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.quiz-head__image {
  width: 292rpx;
  height: 292rpx;
}

.quiz-head__title {
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
}

.quiz-head__equation {
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
}

.count-stage {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-content: center;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  max-width: 560rpx;
  min-height: 220rpx;
  max-height: 320rpx;
  margin: 0 auto;
  padding: 8rpx;
  column-gap: 10rpx;
  row-gap: 12rpx;
}

.count-item {
  display: block;
  width: 92rpx;
  height: 92rpx;
}

/* 图标尺寸随数量缩放 */
.count-stage--1 .count-item { width: 188rpx; height: 188rpx; }
.count-stage--2 .count-item { width: 148rpx; height: 148rpx; }
.count-stage--3 .count-item { width: 128rpx; height: 128rpx; }
.count-stage--4 .count-item { width: 118rpx; height: 118rpx; }
.count-stage--5 .count-item { width: 92rpx; height: 92rpx; }
.count-stage--6 .count-item { width: 98rpx; height: 98rpx; }
.count-stage--7 .count-item { width: 88rpx; height: 88rpx; }
.count-stage--8 .count-item { width: 84rpx; height: 84rpx; }
.count-stage--9 .count-item { width: 92rpx; height: 92rpx; }
.count-stage--10 .count-item { width: 88rpx; height: 88rpx; }

/*
 * 换行宽度 = 每行列数 × 图标 + gap。
 * 列数规则：10 的约数中 ≤ 数量的最大者（10→5）：1 / 2 / 5。
 * 例：3=2+1，4=2+2，7=5+2，10=5+5。
 */
.count-stage--1 { max-width: 204rpx; }
.count-stage--2 { max-width: 322rpx; }
.count-stage--3 { max-width: 282rpx; }
.count-stage--4 { max-width: 262rpx; }
.count-stage--5 { max-width: 516rpx; }
.count-stage--6 { max-width: 546rpx; }
.count-stage--7 { max-width: 496rpx; }
.count-stage--8 { max-width: 476rpx; }
.count-stage--9 { max-width: 516rpx; }
.count-stage--10 { max-width: 496rpx; }


.options {
  display: flex;
  flex-direction: row;
  gap: var(--block-gap);
}

.option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--col-3);
  height: 156rpx;
  font-size: var(--font-display);
  font-weight: 700;
  letter-spacing: var(--letter-btn);
  color: var(--ink);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
  transition: transform 80ms ease-out, box-shadow 80ms ease-out, background 120ms ease-out;
}

.option:active {
  transform: scale(0.98);
}

.option.is-picked {
  background: var(--tone-picked) !important;
  box-shadow:
    var(--shadow-clay-hi),
    inset -7rpx -10rpx 18rpx rgba(184, 136, 28, 0.3),
    0 0 0 6rpx var(--ring-picked),
    0 10rpx 20rpx rgba(96, 122, 96, 0.16);
}

.option.is-correct {
  background: linear-gradient(180deg, #e4f5c4, #9fce6e) !important;
  box-shadow:
    var(--shadow-clay-hi),
    inset -7rpx -10rpx 18rpx rgba(78, 128, 64, 0.28),
    0 0 0 8rpx #62a05e,
    0 12rpx 24rpx rgba(78, 128, 64, 0.28);
}

.soft-note {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: var(--pad-card);
  text-align: center;
  font-size: var(--font-note);
  font-weight: 700;
  color: var(--note);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}
