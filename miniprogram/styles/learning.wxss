/* H5 pages.css · 学习列表 / 详情 / 答题公共结构 */

.media-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-row);
  min-height: var(--size-media-row);
  padding: var(--pad-card);
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.media-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--pad-card);
  flex: 1;
  min-width: 0;
}

.media-main__thumb {
  width: var(--size-media-thumb);
  height: var(--size-media-thumb);
  flex-shrink: 0;
  overflow: hidden;
  border-radius: var(--radius-thumb);
}

.media-main__thumb--wide {
  width: calc(var(--size-media-thumb) * 4 / 3);
}

.media-main__image {
  width: 100%;
  height: 100%;
  display: block;
}

.media-main__title {
  font-size: var(--font-card);
}

.media-main__sub {
  white-space: nowrap;
}

.media-play {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.media-row .media-play,
.poem-line .media-play,
.poem-line .play-btn-hit,
.detail-pair__card .play-btn-hit,
.media-row .play-btn-hit {
  min-width: 0;
  min-height: 0;
  justify-content: flex-end;
}

.duo {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--gap-grid);
}

.duo-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: var(--col-2);
  min-height: 352rpx;
  gap: var(--gap-text);
  padding: var(--pad-card-sm);
  text-align: center;
  border-radius: var(--radius-tile);
  box-sizing: border-box;
}

.duo-card__image {
  width: 188rpx;
  height: 188rpx;
}

.duo-card__title {
  font-size: var(--font-card);
}

/* 每行 3 卡：横向范围由 app-shell 控制，网格内部只用 gap 分隔 */
.word-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 100%;
  gap: var(--gap-grid);
}

.word-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-inset);
  width: var(--col-3);
  height: 248rpx;
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
  border-radius: var(--radius-tile);
  box-sizing: border-box;
}

.word-card:not(.word-card--english):not(.word-card--hanzi) {
  justify-content: space-between;
  padding-top: var(--gap-inset);
  padding-bottom: var(--gap-inset);
}

.word-card__image {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
}

.word-card.is-song .word-card__image {
  width: calc(100% - 48rpx);
  aspect-ratio: 272 / 102;
  height: auto;
  margin-top: 20rpx;
}

.word-card .play-btn-hit {
  margin-top: auto;
}

.word-card__label {
  font-size: var(--font-hint);
  font-weight: 700;
  line-height: 1.1;
  color: var(--ink);
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 0;
}

.word-card--english {
  height: var(--size-word);
}

.word-card--english .word-card__image {
  width: var(--size-word-thumb);
  height: var(--size-word-thumb);
}

.word-card--hanzi {
  height: var(--size-word);
}

.word-card__emoji {
  width: var(--size-word-thumb);
  height: var(--size-word-thumb);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  line-height: 1;
  flex-shrink: 0;
}

.word-card--hanzi .word-card__label {
  font-size: var(--font-title);
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--gap-row);
  padding: var(--pad-card);
  text-align: left;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.hero__bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--pad-card);
  width: 100%;
}

.hero__heading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-text);
  width: 100%;
}

.hero__title {
  max-width: 100%;
  font-size: var(--font-hero);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__play {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero__sub {
  max-width: 100%;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__image {
  display: block;
  align-self: stretch;
  width: 100%;
  height: auto;
  border-radius: var(--radius-thumb);
}

.poem-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--gap-row);
  padding: var(--pad-card);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.poem-line.is-active {
  /* 覆盖 tone-cream，对齐 H5 .poem-line.active */
  background: linear-gradient(180deg, #fff8ee, #f9edc6) !important;
}

.poem-line__text {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  font-size: var(--font-line);
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
}

.detail-big {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--gap-block);
  padding: var(--pad-card-xl);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.detail-big__image {
  width: 320rpx;
  height: 320rpx;
}

.pinyin-vowel-image {
  width: 360rpx;
  height: 360rpx;
}

/* 跟读伙伴坞（对齐 H5 pages.css） */
.buddy-dock {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 176rpx;
  padding: var(--pad-card);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.buddy-dock__mascot {
  width: 156rpx;
  height: 156rpx;
  flex-shrink: 0;
}

.buddy-dock__bubble {
  --buddy-bubble-fill: #dce6cc; /* 伙伴气泡填色（含啾啾） */
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--pad-card);
  overflow: visible;
  border-radius: var(--radius-pill);
  background: var(--buddy-bubble-fill);
  filter: drop-shadow(0 6rpx 12rpx rgba(96, 122, 96, 0.14));
  font-size: var(--font-note);
  font-weight: 700;
  line-height: 1.35;
  color: var(--ink);
  text-align: center;
  box-sizing: border-box;
}

.buddy-dock__bubble-tail {
  position: absolute;
  left: 12rpx;
  top: 50%;
  width: 46rpx;
  height: 42rpx;
  background: var(--buddy-bubble-fill);
  clip-path: polygon(100% 0, 100% 100%, 0 50%);
  transform: translate(-62%, -50%);
  z-index: 0;
}

.buddy-dock__bubble-text {
  position: relative;
  z-index: 1;
}

.detail-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  font-size: 100rpx;
  line-height: 1;
}

.detail-big__glyph {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
}

.detail-big__title {
  font-size: var(--font-inner);
}

.detail-big__meaning {
  font-size: var(--font-note);
  font-weight: 700;
  color: var(--ink);
}

.detail-pair {
  display: flex;
  flex-direction: row;
  gap: var(--gap-block);
}

.detail-pair__card.block {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: var(--gap-row);
  flex: 1;
  width: auto;
  min-width: 0;
  min-height: 120rpx;
  padding: var(--pad-card);
  font-size: var(--font-line);
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.quiz-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--pad-card);
  padding: var(--pad-card-xl) var(--pad-card-lg);
  text-align: center;
  border-radius: var(--radius-card);
  box-sizing: border-box;
}

.quiz-head__image {
  width: 292rpx;
  height: 292rpx;
}

.quiz-head__title {
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
}

.quiz-head__equation {
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
}

.count-stage {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-content: center;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  max-height: 420rpx;
  margin: 0 auto;
  column-gap: var(--gap-row);
  row-gap: var(--gap-row);
}

.count-item {
  display: block;
  width: 110rpx;
  height: 110rpx;
}

/* 图标尺寸随数量缩放；max-width = 列数 × 边长 + 列间距 */
.count-stage--1 .count-item {
  width: 256rpx;
  height: 256rpx;
}
.count-stage--2 .count-item {
  width: 208rpx;
  height: 208rpx;
}
.count-stage--3 .count-item {
  width: 194rpx;
  height: 194rpx;
}
.count-stage--4 .count-item {
  width: 208rpx;
  height: 208rpx;
}
.count-stage--5 .count-item {
  width: 194rpx;
  height: 194rpx;
}
.count-stage--6 .count-item {
  width: 194rpx;
  height: 194rpx;
}
.count-stage--7 .count-item {
  width: 142rpx;
  height: 142rpx;
}
.count-stage--8 .count-item {
  width: 142rpx;
  height: 142rpx;
}
.count-stage--9 .count-item {
  width: 128rpx;
  height: 128rpx;
}
.count-stage--10 .count-item {
  width: 110rpx;
  height: 110rpx;
}

.count-stage--1 {
  max-width: 256rpx;
}
.count-stage--2 {
  max-width: 432rpx;
}
.count-stage--3 {
  max-width: 614rpx;
}
.count-stage--4 {
  max-width: 432rpx;
}
.count-stage--5 {
  max-width: 614rpx;
}
.count-stage--6 {
  max-width: 614rpx;
}
.count-stage--7 {
  max-width: 616rpx;
}
.count-stage--8 {
  max-width: 616rpx;
}
.count-stage--9 {
  max-width: 416rpx;
}
.count-stage--10 {
  max-width: 614rpx;
}

.options {
  display: flex;
  flex-direction: row;
  gap: var(--gap-block);
}

.option {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  width: auto;
  min-width: 0;
  height: var(--size-tap-compact);
  font-size: var(--font-display);
  font-weight: 700;
  color: var(--ink);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
  /* 切题时立刻摘掉选中环，只保留按下缩放 */
  transition: transform 80ms ease-out;
}

.option:active {
  transform: scale(0.98);
}

.option.is-picked {
  background: var(--tone-picked) !important;
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(184, 136, 28, 0.3),
    0 0 0 9rpx var(--ring-picked),
    var(--shadow-lift);
}

.option.is-correct {
  background: var(--tone-ok) !important;
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(78, 128, 64, 0.28),
    0 0 0 9rpx var(--ring-ok),
    var(--shadow-lift);
}

@keyframes option-wiggle {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-10rpx);
  }
  50% {
    transform: translateX(10rpx);
  }
  75% {
    transform: translateX(-6rpx);
  }
}

.option.is-wrong {
  animation: option-wiggle 420ms ease-in-out;
}

.soft-note {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: var(--pad-card);
  text-align: center;
  font-size: var(--font-note);
  font-weight: 700;
  color: var(--note);
  border-radius: var(--radius-bar);
  box-sizing: border-box;
}

.soft-note.tone-matcha {
  color: var(--ink);
}
