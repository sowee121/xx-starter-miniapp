/* H5 blocks.css · 积木卡与基础控件 */

/* 纵向积木间距统一由容器 gap 提供，积木自身不带 margin */
.block,
.block-card,
.card {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.block-card,
.card {
  padding: 28rpx;
}

.tone-cream {
  background: linear-gradient(180deg, #fffdf7 0%, #f9f2e2 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(198, 182, 146, 0.16),
    var(--shadow);
}

.tone-matcha {
  background: linear-gradient(180deg, #f4fae8 0%, #dcecc4 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(152, 186, 122, 0.18),
    var(--shadow);
}

.tone-sky {
  background: linear-gradient(180deg, #f4fafd 0%, #dbeaf7 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(136, 174, 204, 0.16),
    var(--shadow);
}

.tone-butter {
  background: linear-gradient(180deg, #fefbee 0%, #f9edc6 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(206, 178, 108, 0.16),
    var(--shadow);
}

.tone-peach {
  background: linear-gradient(180deg, #fef7f3 0%, #f8e2da 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(206, 158, 142, 0.15),
    var(--shadow);
}

.tone-mint {
  background: linear-gradient(180deg, #f1fbf6 0%, #d3ebe0 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(126, 178, 156, 0.16),
    var(--shadow);
}

.tone-lilac {
  background: linear-gradient(180deg, #f8f5fd 0%, #e8e1f6 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(160, 142, 198, 0.15),
    var(--shadow);
}

.tone-apricot {
  background: linear-gradient(180deg, #fff8ee 0%, #fbe4cb 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(210, 164, 112, 0.16),
    var(--shadow);
}

.tone-rose {
  background: linear-gradient(180deg, #fef5f8 0%, #f8dde6 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.95),
    inset 0 -12rpx 20rpx rgba(206, 148, 170, 0.15),
    var(--shadow);
}

.tone-night {
  background:
    radial-gradient(circle at 20% 12%, rgba(150, 164, 224, 0.24), transparent 34%),
    linear-gradient(180deg, #424a78 0%, #29345f 52%, #202a4d 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.18),
    inset 0 -14rpx 24rpx rgba(12, 18, 46, 0.28),
    0 12rpx 24rpx rgba(42, 49, 91, 0.2),
    0 24rpx 44rpx rgba(42, 49, 91, 0.16);
}

/* 兼容旧 tint-* 类名 → 落到 tone 渐变 */
.tint-cream { background: linear-gradient(180deg, #fffdf7 0%, #f9f2e2 100%); }
.tint-matcha { background: linear-gradient(180deg, #f4fae8 0%, #dcecc4 100%); }
.tint-sky { background: linear-gradient(180deg, #f4fafd 0%, #dbeaf7 100%); }
.tint-butter,
.tint-lemon { background: linear-gradient(180deg, #fefbee 0%, #f9edc6 100%); }
.tint-peach { background: linear-gradient(180deg, #fef7f3 0%, #f8e2da 100%); }
.tint-mint { background: linear-gradient(180deg, #f1fbf6 0%, #d3ebe0 100%); }
.tint-lilac { background: linear-gradient(180deg, #f8f5fd 0%, #e8e1f6 100%); }
.tint-apricot { background: linear-gradient(180deg, #fff8ee 0%, #fbe4cb 100%); }
.tint-rose { background: linear-gradient(180deg, #fef5f8 0%, #f8dde6 100%); }

.tap-target {
  min-width: var(--tap-min);
  min-height: var(--tap-min);
}

.chip,
.big-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 0;
  font-weight: 700;
  color: #ffffff;
  border-radius: var(--radius-pill);
  background: linear-gradient(180deg, #93c496, #77b07c);
  box-shadow: var(--shadow-chip);
  box-sizing: border-box;
}

.chip {
  width: 168rpx;
  height: 76rpx;
  font-size: 26rpx;
}

.chip.is-compact {
  width: 132rpx;
  height: 56rpx;
  margin-top: 12rpx;
  font-size: 22rpx;
  border-radius: 28rpx;
}

.chip.is-follow {
  margin-top: 34rpx;
}

.big-btn {
  width: 100%;
  height: 104rpx;
  font-size: 32rpx;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 36rpx;
  background: linear-gradient(180deg, #9dcca0, #7bb37f);
  box-shadow:
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.42),
    inset 0 -6rpx 12rpx rgba(78, 128, 84, 0.28),
    0 8rpx 16rpx rgba(96, 122, 96, 0.16);
}

.play-btn__icon {
  display: block;
  width: 34rpx;
  height: 34rpx;
  margin-left: 3rpx;
}

.play-btn.is-lg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
}

.play-btn.is-lg .play-btn__icon {
  width: 42rpx;
  height: 42rpx;
}

.play-btn.is-sm {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}

.play-btn.is-sm .play-btn__icon {
  width: 26rpx;
  height: 26rpx;
}

.inner-head {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.inner-head__title {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.inner-head__sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}

.section-title {
  margin: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--muted);
}

/* 分组：标题与其列表贴得更近，组与组之间由外层 gap 分隔 */
.section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.muted-action {
  opacity: 0.55;
}
