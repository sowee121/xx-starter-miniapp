/* H5 blocks.css · 积木卡与基础控件 */

/* 纵向积木间距统一由容器 gap 提供，积木自身不带 margin */
.block {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

.block,
.play-btn-hit,
.play-btn,
.trail-nav__item,
.chip,
.big-btn,
.custom-header__home,
.praise-sun__continue,
.volume-option,
.home-welcome,
.home-feature-card,
.home-module-card {
  transition: var(--motion-tap);
}

/* 仅 hover-class / 可点控件按下；静态积木不要 .block:active */
.is-pressed,
.play-btn-hit:active .play-btn,
.play-btn:active,
.trail-nav__item:active,
.custom-header__home:active,
.praise-sun__continue:active,
.volume-option:active {
  transform: scale(0.985);
}

.trail-nav__item.is-disabled:active,
.trail-nav__item.is-disabled.is-pressed,
.chip.is-owned:active,
.chip.is-owned.is-pressed,
.chip.is-short:active,
.chip.is-short.is-pressed,
.big-btn.is-disabled:active,
.big-btn.is-disabled.is-pressed {
  transform: none;
}

/* 对角 inset = 鹅卵石鼓边（上左高光 / 下右压暗），外阴影托起厚度 */
.tone-cream {
  background: var(--tone-cream);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(148, 170, 152, 0.2),
    var(--shadow);
}

.tone-matcha {
  background: linear-gradient(180deg, #f4fae8 0%, #dcecc4 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(152, 186, 122, 0.26),
    var(--shadow);
}

.tone-sky {
  background: linear-gradient(180deg, #f4fafd 0%, #dbeaf7 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(136, 174, 204, 0.24),
    var(--shadow);
}

.tone-butter {
  background: linear-gradient(180deg, #fefbee 0%, #f9edc6 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(206, 178, 108, 0.24),
    var(--shadow);
}

.tone-peach {
  background: linear-gradient(180deg, #fef7f3 0%, #f8e2da 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(206, 158, 142, 0.22),
    var(--shadow);
}

.tone-mint {
  background: linear-gradient(180deg, #f1fbf6 0%, #d3ebe0 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(126, 178, 156, 0.24),
    var(--shadow);
}

.tone-lilac {
  background: linear-gradient(180deg, #f8f5fd 0%, #e8e1f6 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(160, 142, 198, 0.22),
    var(--shadow);
}

.tone-apricot {
  background: linear-gradient(180deg, #fff8ee 0%, #fbe4cb 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(210, 164, 112, 0.24),
    var(--shadow);
}

.tone-rose {
  background: linear-gradient(180deg, #fef5f8 0%, #f6d4e0 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(206, 148, 170, 0.28),
    var(--shadow);
}

.tone-night {
  background:
    radial-gradient(circle at 20% 12%, rgba(150, 164, 224, 0.24), transparent 34%),
    linear-gradient(180deg, #424a78 0%, #29345f 52%, #202a4d 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.18),
    inset 0 -14rpx 24rpx rgba(12, 18, 46, 0.28),
    0 12rpx 24rpx rgba(42, 49, 91, 0.2),
    0 24rpx 44rpx rgba(42, 49, 91, 0.16);
}

.chip,
.big-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 0;
  font-weight: 700;
  letter-spacing: var(--letter-btn);
  color: #ffffff;
  border-radius: var(--radius-pill);
  background-color: #77b07c;
  background-image: var(--btn-green);
  box-shadow: var(--shadow-chip);
  box-sizing: border-box;
}

.chip {
  width: 200rpx;
  height: 100rpx;
  font-size: var(--font-hint);
}

.chip.is-compact {
  min-width: 168rpx;
  width: auto;
  height: 88rpx;
  font-size: var(--font-hint);
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.chip.is-owned {
  font-weight: 800;
  background: rgba(255, 253, 247, 0.88);
  color: var(--muted);
  box-shadow:
    var(--shadow-clay-hi),
    inset -4rpx -5rpx 10rpx rgba(198, 182, 146, 0.16);
}

.chip.is-short {
  opacity: var(--opacity-disabled);
}

.chip:active {
  transform: scale(0.97);
}

.chip.is-owned,
.chip.is-short {
  pointer-events: none;
}

.chip.is-owned:active,
.chip.is-short:active {
  transform: none;
}

/* 已拥有贴纸：加深原阴影，不加描边 */
.sticker-card.block.is-owned {
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(198, 182, 146, 0.2),
    var(--shadow-owned);
}

.big-btn {
  width: 100%;
  height: 136rpx;
  font-size: var(--font-card);
  gap: var(--gap-soft);
}

.big-btn:active {
  transform: scale(0.98);
}

.big-btn.is-disabled,
.big-btn.is-disabled:active {
  opacity: var(--opacity-disabled);
  transform: none;
  pointer-events: none;
}

/* 圆钮视觉在 components/play-button；此处只保留按下过渡 */

/* 通用石子径：详情切项 / 拼音字母 */
.trail-nav {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--trail-gap);
  box-sizing: border-box;
}

.trail-nav.is-step {
  justify-content: stretch;
  gap: var(--gap-pair);
}

.trail-nav.is-step .trail-nav__item {
  flex: 1;
  width: auto;
  min-width: 0;
  height: 112rpx;
  border-radius: var(--radius-pill);
  /* 跟组词 / 诗行 / 例句同一套奶油黏土面，不要石子径冷灰绿 */
  background: var(--tone-cream);
  box-shadow: var(--shadow-clay);
}

.trail-nav.is-step .trail-nav__arrow {
  width: 88rpx;
  height: 88rpx;
}

/* 切题钮贴底固定，不与行内提示抢文档流 */
.trail-nav.is-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(156rpx + env(safe-area-inset-bottom));
  z-index: 12;
  padding: 0 var(--page-pad-x);
  pointer-events: none;
}

.trail-nav.is-dock .trail-nav__item {
  pointer-events: auto;
}

.detail-stack.is-docked {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.trail-nav__item {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--trail-size);
  height: var(--trail-size);
  /* 单字默认正圆 */
  border-radius: 999rpx;
  border: 0;
  background: var(--trail-face);
  box-shadow: var(--shadow-trail);
  font-size: var(--trail-font);
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
  text-decoration: none;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 墨水区相对字盒偏下：只上移字形，不挪动石子圆面 */
.trail-nav__glyph {
  display: block;
  line-height: 1;
  transform: translateY(-0.08em);
}

.trail-nav__arrow {
  width: 64rpx;
  height: 64rpx;
  display: block;
}

.trail-nav__arrow.is-flip {
  transform: scaleX(-1);
}

.trail-nav__item.is-current {
  background: var(--tone-ok);
  box-shadow: var(--shadow-trail-current);
}

.trail-nav__item.is-disabled {
  opacity: var(--opacity-disabled);
  pointer-events: none;
}

.inner-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-text);
}

.inner-head__title {
  font-size: var(--font-inner);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.inner-head__sub {
  font-size: var(--font-hint);
  color: var(--muted);
  white-space: nowrap;
}

.section-title {
  margin: 0;
  font-size: var(--font-hint);
  font-weight: 700;
  color: var(--muted);
}

/* 分组：标题与卡片列表统一用页内卡片间距 */
.section {
  display: flex;
  flex-direction: column;
  gap: var(--gap-block);
}
