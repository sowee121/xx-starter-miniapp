/* H5 blocks.css · 积木卡与基础控件 */

/* 纵向积木间距统一由容器 gap 提供，积木自身不带 margin */
.block {
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-card);
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 对角 inset = 鹅卵石鼓边（上左高光 / 下右压暗），外阴影托起厚度 */
.tone-cream {
  background: var(--tone-cream);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(148, 170, 152, 0.2),
    var(--shadow);
}

.tone-matcha {
  background: linear-gradient(180deg, #f4fae8 0%, #dcecc4 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(152, 186, 122, 0.26),
    var(--shadow);
}

.tone-sky {
  background: linear-gradient(180deg, #f4fafd 0%, #dbeaf7 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(136, 174, 204, 0.24),
    var(--shadow);
}

.tone-butter {
  background: linear-gradient(180deg, #fefbee 0%, #f9edc6 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(206, 178, 108, 0.24),
    var(--shadow);
}

.tone-peach {
  background: linear-gradient(180deg, #fef7f3 0%, #f8e2da 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(206, 158, 142, 0.22),
    var(--shadow);
}

.tone-mint {
  background: linear-gradient(180deg, #f1fbf6 0%, #d3ebe0 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(126, 178, 156, 0.24),
    var(--shadow);
}

.tone-lilac {
  background: linear-gradient(180deg, #f8f5fd 0%, #e8e1f6 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(160, 142, 198, 0.22),
    var(--shadow);
}

.tone-apricot {
  background: linear-gradient(180deg, #fff8ee 0%, #fbe4cb 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(210, 164, 112, 0.24),
    var(--shadow);
}

.tone-rose {
  background: linear-gradient(180deg, #fef5f8 0%, #f6d4e0 100%);
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(206, 148, 170, 0.28),
    var(--shadow);
}

.tone-night {
  background:
    radial-gradient(circle at 20% 12%, rgba(150, 164, 224, 0.24), transparent 34%),
    linear-gradient(180deg, #424a78 0%, #29345f 52%, #202a4d 100%);
  box-shadow:
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.18),
    inset 0 -14rpx 24rpx rgba(12, 18, 46, 0.28),
    0 12rpx 24rpx rgba(42, 49, 91, 0.2),
    0 24rpx 44rpx rgba(42, 49, 91, 0.16);
}

.chip,
.big-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border: 0;
  font-weight: 700;
  letter-spacing: var(--letter-btn);
  color: #ffffff;
  border-radius: var(--radius-pill);
  background: var(--btn-green);
  box-shadow: var(--shadow-chip);
  box-sizing: border-box;
}

.chip {
  width: 200rpx;
  height: 100rpx;
  font-size: var(--font-hint);
}

.chip.is-compact {
  min-width: 168rpx;
  width: auto;
  height: 88rpx;
  font-size: var(--font-hint);
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.chip.is-owned {
  font-weight: 800;
  background: rgba(255, 253, 247, 0.88);
  color: var(--muted);
  box-shadow:
    var(--shadow-clay-hi),
    inset -4rpx -5rpx 10rpx rgba(198, 182, 146, 0.16);
}

.chip.is-short {
  opacity: var(--opacity-disabled);
}

.chip:active {
  transform: scale(0.97);
}

.chip.is-owned,
.chip.is-short {
  pointer-events: none;
}

.chip.is-owned:active,
.chip.is-short:active {
  transform: none;
}

/* 已拥有贴纸：加深原阴影，不加描边 */
.sticker-card.block.is-owned {
  box-shadow:
    var(--shadow-clay-hi),
    inset -8rpx -10rpx 18rpx rgba(198, 182, 146, 0.2),
    var(--shadow-owned);
}

.big-btn {
  width: 100%;
  height: 136rpx;
  font-size: var(--font-card);
  gap: var(--gap-soft);
}

.big-btn:active {
  transform: scale(0.98);
}

.big-btn.is-disabled,
.big-btn.is-disabled:active {
  opacity: var(--opacity-disabled);
  transform: none;
  pointer-events: none;
}

.play-btn-hit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: var(--tap-min);
  min-height: var(--tap-min-compact);
  box-sizing: border-box;
}

.play-btn-hit.is-flush {
  min-width: 0;
  min-height: 0;
}

.play-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 46rpx;
  background: var(--btn-play);
  box-shadow: var(--shadow-play);
}

.play-btn__icon {
  display: block;
  width: 44rpx;
  height: 44rpx;
  margin-left: 0;
}

.play-btn.is-lg {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
}

.play-btn.is-lg .play-btn__icon {
  width: 54rpx;
  height: 54rpx;
}

.play-btn.is-sm {
  width: 76rpx;
  height: 76rpx;
  border-radius: 38rpx;
}

.play-btn.is-sm .play-btn__icon {
  width: 36rpx;
  height: 36rpx;
}

/* 通用石子径：详情切项 / 上一个·下一个；可用 CSS 变量或 .is-sm 覆写尺寸 */
.trail-nav,
.pebble-trail {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: var(--trail-gap);
  box-sizing: border-box;
  margin-top: var(--gap-card);
}

/* 切题钮贴底固定，不与行内提示抢文档流 */
.trail-nav.is-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 12;
  margin-top: 0;
  padding: 0 var(--page-pad-x);
  pointer-events: none;
}

.trail-nav.is-dock .trail-nav__item {
  pointer-events: auto;
}

.detail-stack.is-docked,
.section.is-docked {
  padding-bottom: calc(264rpx + env(safe-area-inset-bottom));
}

.trail-nav__item,
.pebble {
  position: relative;
  display: grid;
  place-items: center;
  width: var(--trail-size);
  height: var(--trail-size);
  /* 单字默认正圆 */
  border-radius: 999rpx;
  border: 0;
  background: var(--trail-face);
  box-shadow: var(--shadow-trail);
  font-size: var(--trail-font);
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
  text-decoration: none;
  box-sizing: border-box;
  flex-shrink: 0;
}

/* 墨水区相对字盒偏下：只上移字形，不挪动石子圆面 */
.trail-nav__glyph {
  display: block;
  line-height: 1;
  transform: translateY(-0.08em);
}

.trail-nav__item.is-wide .trail-nav__glyph {
  transform: none;
}

/* 多字（上一个 / 下一个等）：绿色全圆角钮，对齐 chip */
.trail-nav__item.is-wide,
.pebble.is-wide {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 228rpx;
  height: 112rpx;
  padding: 0 52rpx;
  border-radius: var(--radius-pill);
  font-size: var(--font-body);
  letter-spacing: var(--letter-btn);
  color: #ffffff;
  background: var(--btn-green);
  box-shadow: var(--shadow-chip);
}

.trail-nav__item.is-current,
.pebble.is-current {
  box-shadow: var(--shadow-trail-current);
}

.trail-nav__item.is-disabled,
.pebble.is-disabled {
  opacity: var(--opacity-disabled);
  pointer-events: none;
}

.trail-nav.is-sm,
.pebble-trail.is-sm {
  --trail-gap: 16rpx;
  --trail-size: 76rpx;
  --trail-font: 40rpx;
}

.inner-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--gap-text);
}

.inner-head__title {
  font-size: var(--font-inner);
  font-weight: 700;
  line-height: 1.2;
  color: var(--ink);
}

.inner-head__sub {
  font-size: var(--font-hint);
  color: var(--muted);
  white-space: nowrap;
}

.section-title {
  margin: 0;
  font-size: var(--font-hint);
  font-weight: 700;
  color: var(--muted);
}

/* 分组：标题与卡片列表统一用页内卡片间距 */
.section {
  display: flex;
  flex-direction: column;
  gap: var(--block-gap);
}
