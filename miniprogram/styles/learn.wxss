/* 每行 3 卡：横向范围由 app-shell 控制，网格内部只用 gap 分隔 */
.word-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 100%;
  gap: var(--gap-grid);
}

.detail-pair {
  display: flex;
  flex-direction: row;
  gap: var(--gap-block);
}
