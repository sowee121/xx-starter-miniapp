page {
  /* H5 tokens.css · 750 画板 1px = 1rpx */

  /* —— 色 —— */
  --ink: #4d6f58; /* 正文、标题 */
  --muted: #6e8f76; /* 辅助说明、弱化文案 */
  --night-ink: #fffaf0; /* 夜景正文 */
  --night-muted: #dce2fa; /* 夜景辅助文案 */
  --note: #a97946; /* 提示、软失败文案 */
  --board: #e9f2dc; /* 页底/画板底色 */
  --sky-top: #dcefdc; /* 日间天空上沿（与 meadow 同族） */
  --sky-mid: #e3f2dc; /* 日间天空中段 */
  --night-top: #5e6e91; /* 夜景天空/页顶 */
  --night-strong: #3a426e; /* 夜景强调字色（星数等） */
  --btn-green-solid: #77b07c; /* 绿钮实色底（渐变下沿） */
  --tone-leaf: linear-gradient(145deg, #f7f9e9, #e6efd6); /* 叶绿钮面：回首页、日间星条 */
  --tone-leaf-solid: #eef3e2; /* 叶绿实色底 */
  --tone-leaf-night: linear-gradient(145deg, #f4f6fb, #c8d0ea); /* 夜色钮面 */

  /* —— 圆角：普通圆弧。卡内图 ≈ 外圆角 − 内边距（56 − 28） —— */
  --radius-card: 56rpx; /* 大卡：首页、通栏、详情、带缩略图列表行 */
  --radius-tile: 48rpx; /* 小卡：字卡、双卡、任务行 */
  --radius-bar: 40rpx; /* 矮条：诗行、选项、伙伴坞、软提示 */
  --radius-thumb: 28rpx; /* 缩略图 / 卡内插图 */
  --radius-cell: 16rpx; /* 热力小方块 */
  --radius-pill: 999rpx; /* 胶囊：chip、星条、气泡、标签 */

  /* —— 尺寸 —— */
  --size-header: 88rpx; /* 导航栏高、回首页钮、绿胶囊紧凑高 */
  --size-chip-lg: 100rpx; /* 绿胶囊默认高度 */
  --size-chip-wide: 200rpx; /* 绿胶囊默认宽度 */
  --size-chip-min: 168rpx; /* 绿胶囊紧凑最小宽 */
  --size-arrow: 100rpx; /* 切题导航箭头图 */
  --size-canvas: 750rpx; /* 设计画板宽 */
  --size-canvas-min: 1624rpx; /* 设计画板最小高 */
  --size-meadow: 390rpx; /* 页底草地高 */
  --size-praise: calc(100% - var(--pad-page) * 2); /* 表扬弹层卡片宽，左右各留页边 */
  --size-praise-min: 760rpx; /* 表扬弹层卡片最小高 */
  --size-praise-icon: 288rpx; /* 表扬弹层主图 */
  --size-slot: 112rpx; /* 通栏钮 / 清除槽 / 音量档 / 切题条 / 大号播放 */
  --size-mascot: 168rpx; /* 首页通栏吉祥物 / 模块卡吉祥物 / 商城贴纸大图 */
  --size-word: 210rpx; /* 英语/识字列表字卡高 */
  --size-word-thumb: 88rpx; /* 字卡缩略图 */
  --size-play: 92rpx; /* 播放圆钮默认边长 */
  --size-play-sm: 76rpx; /* 播放圆钮小号 */
  --size-play-icon: 44rpx; /* 播放 / 停止图标默认 */
  --size-play-icon-lg: 54rpx; /* 播放图标大号 */
  --size-play-icon-sm: 36rpx; /* 播放图标小号 */
  --size-star-bar: 64rpx; /* 积分星条高度 */
  --size-star: 48rpx; /* 星星图标边长 */
  --size-media-row: 180rpx; /* 古诗等媒体列表行高 */
  --size-media-thumb: 132rpx; /* 媒体列表缩略图边长 */
  --size-trail: 96rpx; /* 拼音石子径单字圆面 */
  --size-tap-compact: 128rpx; /* 选项高度 */

  /* —— 石子径（拼音字母圆面） —— */
  --font-trail: 56rpx; /* 石子径字母字号 */
  --tone-trail: linear-gradient(165deg, #fafcf9 0%, #f2f6f1 55%, #e8efe9 100%); /* 石子径圆面 */
  --shadow-trail: /* 石子径默认鼓边 */
    inset 7rpx 6rpx 12rpx rgba(255, 255, 255, 0.14),
    inset -7rpx -9rpx 16rpx rgba(148, 170, 152, 0.2), 0 1rpx 0 rgba(255, 255, 255, 0.08),
    0 10rpx 18rpx rgba(96, 122, 96, 0.15), 0 18rpx 28rpx rgba(96, 122, 96, 0.08);
  --shadow-trail-current: /* 石子径当前项：叶绿面 + 绿环 */
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(78, 128, 64, 0.28),
    0 0 0 9rpx var(--ring-ok), var(--shadow-lift);

  /* —— 阴影 —— */
  --shadow-lift: /* 卡片外托，浮起厚度 */
    0 8rpx 14rpx rgba(96, 122, 96, 0.1), 0 18rpx 36rpx rgba(96, 122, 96, 0.12),
    0 28rpx 48rpx rgba(96, 122, 96, 0.08);
  --shadow-clay-hi: inset 8rpx 7rpx 14rpx rgba(255, 255, 255, 0.1); /* 鼓边上左高光 */
  --shadow-clay-lo: inset -8rpx -10rpx 18rpx rgba(198, 182, 146, 0.2); /* 奶油面下右压暗 */
  --shadow-clay: /* 标准奶油鹅卵石：高光 + 压暗 + 外托 */
    var(--shadow-clay-hi), var(--shadow-clay-lo), var(--shadow-lift);
  --shadow-clay-praise: /* 表扬弹层：加厚鼓边 + 柔和外托，强化鹅卵石感 */
    inset 10rpx 9rpx 20rpx rgba(255, 255, 255, 0.18),
    inset -12rpx -14rpx 28rpx rgba(198, 182, 146, 0.3), 0 10rpx 18rpx rgba(96, 122, 96, 0.14),
    0 24rpx 44rpx rgba(96, 122, 96, 0.16), 0 44rpx 80rpx rgba(96, 122, 96, 0.1);
  --shadow-clay-leaf: /* 浅绿黏土（回首页钮、日间星条） */
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(112, 145, 91, 0.22),
    0 8rpx 16rpx rgba(83, 112, 73, 0.14), 0 16rpx 28rpx rgba(83, 112, 73, 0.08);
  --shadow-clay-night: /* 夜色鹅卵石 */
    inset 8rpx 8rpx 16rpx rgba(255, 255, 255, 0.22),
    inset -8rpx -10rpx 18rpx rgba(12, 18, 46, 0.32), 0 10rpx 20rpx rgba(18, 26, 57, 0.22),
    0 22rpx 40rpx rgba(18, 26, 57, 0.14);
  --shadow-owned: /* 已拥有贴纸：加深外托 */
    var(--shadow-clay-hi), var(--shadow-clay-lo), 0 16rpx 32rpx rgba(96, 122, 96, 0.36),
    0 36rpx 64rpx rgba(96, 122, 96, 0.3);
  --shadow-chip: /* 绿钮 / 播放圆钮鼓边（与卡片同套对角，压暗偏绿） */
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(78, 128, 84, 0.3), var(--shadow-lift);
  --shadow-socket: /* 首页星槽空槽（凹） */
    inset 6rpx 6rpx 11rpx rgba(104, 136, 102, 0.22),
    inset -5rpx -6rpx 10rpx rgba(255, 255, 255, 0.14);
  --shadow-socket-on: /* 首页星槽已点亮 */
    inset 5rpx 5rpx 10rpx rgba(104, 136, 102, 0.14),
    inset -5rpx -6rpx 10rpx rgba(255, 255, 255, 0.16);

  /* —— 填充 / 色面 —— */
  --btn-green: linear-gradient(180deg, #88c08d, var(--btn-green-solid)); /* 绿 CTA / 播放圆钮面 */
  --tone-cream: linear-gradient(180deg, #fafcf9 0%, #f1f5f1 100%); /* 奶油卡面 */
  --shadow-tone-cream:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(148, 170, 152, 0.2), var(--shadow-lift);
  --tone-soft-fail: linear-gradient(180deg, #fffaf0 0%, #f8e8c5 100%); /* 软失败提示面 */
  --tone-picked: linear-gradient(180deg, #fff3c4, #f0cc58); /* 选项选中 */
  --ring-picked: #e0b43c; /* 选中环 */
  --tone-ok: linear-gradient(180deg, #e4f5c4, #9fce6e); /* 答对 / 当前石子 */
  --ring-ok: #62a05e; /* 答对环 */
  --heat-lv0: rgba(77, 111, 88, 0.1); /* 热力空档 */
  --heat-lv1: #c8e6b4; /* 热力少 */
  --heat-lv2: #8ec97a; /* 热力中 */
  --heat-lv3: #4f9a5a; /* 热力较多 */
  --heat-lv4: #2f6d42; /* 热力多 */
  --heat-lv0-night: rgba(220, 226, 250, 0.16); /* 夜景热力空档 */

  /* —— 家长区四卡主题：每日任务 / 学习记录 / 兑换贴纸 / 星星积分 —— */
  --tone-matcha: linear-gradient(180deg, #f4fae8 0%, #dcecc4 100%); /* 任务卡面（绿） */
  --tone-sky: linear-gradient(180deg, #f4fafd 0%, #dbeaf7 100%); /* 记录卡面（蓝） */
  --tone-rose: linear-gradient(
    180deg,
    #fef5f8 0%,
    #f6d4e0 100%
  ); /* 贴纸卡面（玫红，同首页积分商城） */
  --tone-apricot: linear-gradient(180deg, #fff8ee 0%, #fbe4cb 100%); /* 积分卡面（杏橙） */
  --shadow-tone-matcha:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(152, 186, 122, 0.26), var(--shadow-lift);
  --shadow-tone-sky:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(136, 174, 204, 0.24), var(--shadow-lift);
  --shadow-tone-rose:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(206, 148, 170, 0.28), var(--shadow-lift);
  --shadow-tone-apricot:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(210, 164, 112, 0.24), var(--shadow-lift);

  /* —— 首页六模块色调（拼音/英语/识字/古诗/算术/日历）—— */
  --tone-butter: linear-gradient(180deg, #fefbee 0%, #f9edc6 100%); /* 拼音/选项·黄油 */
  --tone-tan: linear-gradient(180deg, #f7ecdf 0%, #e6cfb3 100%); /* 英语·茶棕（调淡） */
  --tone-sand: linear-gradient(180deg, #fbf4e8 0%, #ecd9c0 100%); /* 算术/小狗·燕麦米 */
  --tone-orange: linear-gradient(180deg, #fff0e0 0%, #f5d4ac 100%); /* 识字·杏橘 */
  --tone-coral: linear-gradient(180deg, #fff0ec 0%, #f5c9bd 100%); /* 古诗·珊瑚 */
  --tone-pink: linear-gradient(180deg, #fdf2f0 0%, #f0deda 100%); /* 算术·粉米 */
  --tone-frost: linear-gradient(180deg, #eef4fa 0%, #d4e1ee 100%); /* 日历·霜蓝 */
  --shadow-tone-butter:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(206, 178, 108, 0.24), var(--shadow-lift);
  --shadow-tone-tan:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(196, 162, 118, 0.2), var(--shadow-lift);
  --shadow-tone-sand:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(200, 170, 130, 0.22), var(--shadow-lift);
  --shadow-tone-orange:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(216, 170, 122, 0.22), var(--shadow-lift);
  --shadow-tone-coral:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(198, 148, 132, 0.24), var(--shadow-lift);
  --shadow-tone-pink:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(198, 160, 150, 0.2), var(--shadow-lift);
  --shadow-tone-frost:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(142, 174, 206, 0.2), var(--shadow-lift);

  /* —— 功能浅色：选项 / 任务行 / 古诗列表等 —— */
  --tone-peach: linear-gradient(180deg, #fef7f3 0%, #f8e2da 100%); /* 选项·蜜桃 */
  --tone-mint: linear-gradient(180deg, #f1fbf6 0%, #d3ebe0 100%); /* 数一数/已完成任务·薄荷 */
  --tone-lilac: linear-gradient(180deg, #f8f5fd 0%, #e8e1f6 100%); /* 选项/古诗列表·丁香 */
  --shadow-tone-peach:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(206, 158, 142, 0.22), var(--shadow-lift);
  --shadow-tone-mint:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(126, 178, 156, 0.24), var(--shadow-lift);
  --shadow-tone-lilac:
    var(--shadow-clay-hi), inset -8rpx -10rpx 18rpx rgba(160, 142, 198, 0.22), var(--shadow-lift);
  --tone-night:
    radial-gradient(circle at 20% 12%, rgba(150, 164, 224, 0.24), transparent 34%),
    linear-gradient(180deg, #424a78 0%, #29345f 52%, #202a4d 100%); /* 夜景卡面（阴影复用 --shadow-clay-night） */
  --btn-sky: linear-gradient(180deg, #a8cff2, #82b2e6); /* 记录清除钮 */
  --btn-rose: linear-gradient(180deg, #e0a4b4, #c88698); /* 贴纸清除钮（默认钮面） */
  --btn-apricot: linear-gradient(180deg, #eec99a, #d5a264); /* 积分清除钮 */
  --shadow-btn-hi: inset 0 4rpx 8rpx rgba(255, 255, 255, 0.28); /* 清除钮上沿高光 */
  --shadow-btn-rose:
    var(--shadow-btn-hi), inset 0 -6rpx 12rpx rgba(160, 90, 110, 0.28),
    0 8rpx 16rpx rgba(180, 120, 140, 0.18);
  --shadow-btn-sky:
    var(--shadow-btn-hi), inset 0 -6rpx 12rpx rgba(90, 140, 190, 0.28),
    0 8rpx 16rpx rgba(120, 160, 210, 0.18);
  --shadow-btn-apricot:
    var(--shadow-btn-hi), inset 0 -6rpx 12rpx rgba(170, 120, 60, 0.28),
    0 8rpx 16rpx rgba(190, 140, 90, 0.18);

  --motion-tap:
    transform 80ms ease-out, box-shadow 120ms ease-out, background 120ms ease-out,
    color 120ms ease-out; /* 按下过渡 */

  /* —— 字号 —— */
  --font-nav: 28rpx; /* 导航、积分数字；全站下限 */
  --font-hint: 32rpx; /* 提示、弱说明 */
  --font-body: 34rpx; /* 正文默认 */
  --font-title: 36rpx; /* 页标题、欢迎语副级 */
  --font-card: 38rpx; /* 卡片标题、长条按钮 */
  --font-note: 42rpx; /* 软提示、伙伴气泡 */
  --font-line: 44rpx; /* 诗行、组词、例句 */
  --font-inner: 46rpx; /* 详情内页大标题 */
  --font-hero: 48rpx; /* 古诗封面题名、日历日期 */
  --font-display: 58rpx; /* 选项数字、字卡 */
  --letter-btn: 2rpx; /* 全站字距；所有文字继承 */
  --font-family:
    'Yuanti SC', 'Yuanti TC', 'PingFang SC', 'Hiragino Sans GB', 'Heiti SC', sans-serif; /* 有圆体用圆体，否则苹方 */

  /* —— 间距 —— */
  --gap-snug: 10rpx; /* 欢迎卡内、音量轨内边距 */
  --gap-text: 12rpx; /* 标题与说明 */
  --gap-row: 16rpx; /* 行内：文案与播放钮 */
  --gap-soft: 18rpx; /* 绿钮内、表扬卡内 */
  --gap-trail: 22rpx; /* 拼音石子径圆面间距 */
  --gap-inset: 24rpx; /* 导航内、字卡内 */
  --gap-grid: 30rpx; /* 列表卡片、两列/三列网格 */
  --gap-block: 38rpx; /* 详情主卡到选项等积木间距 */

  /* —— 内边距 —— */
  --pad-card-sm: 20rpx; /* 小卡、双入口 */
  --pad-card: 28rpx; /* 标准卡内边距；题头/设置头内间距 */
  --pad-card-lg: 36rpx; /* 设置卡、题头左右 */
  --pad-card-xl: 56rpx; /* 详情主卡、题头上下 */
  --pad-page: 30rpx; /* 页左右 / 页底安全边 */

  /* —— 栅格 —— */
  --col-2: calc((100% - var(--gap-grid)) / 2); /* 首页两列 */
  --col-3: calc((100% - var(--gap-grid) * 2) / 3); /* 字卡/贴纸三列 */

  --opacity-disabled: 0.86; /* 禁用、未完成弱化 */

  background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-mid) 58%, var(--board) 100%);
  color: var(--ink);
  font-size: var(--font-body);
  font-family: var(--font-family);
  letter-spacing: var(--letter-btn); /* 全站字距 */
}
