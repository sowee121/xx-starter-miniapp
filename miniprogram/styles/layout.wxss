/* 布局原子：只管"怎么排"（排列与间距），不含颜色 / 阴影 / 字体等外观属性
   外观与交互见 blocks.wxss；页面与组件均可使用 */

.page-list {
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
}

.detail-stack {
  display: flex;
  flex-direction: column;
  gap: var(--gap-block);
}

.parent-stack {
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
}

/* 每行 3 卡：横向范围由 app-shell 控制，网格内部只用 gap 分隔 */
.word-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: flex-start;
  box-sizing: border-box;
  width: 100%;
  gap: var(--gap-grid);
}

.detail-pair {
  display: flex;
  flex-direction: row;
  gap: var(--gap-block);
}

/* 列表分组：标题与同类卡片用网格间距 30 */
.section-title {
  margin: 0;
  font-size: var(--font-title);
  font-weight: 700;
  color: var(--muted);
}

.section {
  display: flex;
  flex-direction: column;
  gap: var(--gap-grid);
}
